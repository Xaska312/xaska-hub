diff --git a/src/components/ChapterTabs.astro b/src/components/ChapterTabs.astro
new file mode 100644
index 0000000..63238fb
--- /dev/null
+++ b/src/components/ChapterTabs.astro
@@ -0,0 +1,173 @@
+---
+/**
+ * Pestañas con el lema de XASKA POS (Vende, Fía, Cobra, Controla): a la izquierda qué hace,
+ * a la derecha renglones de ejemplo como se ven en la app.
+ *
+ * Patrón de pestañas de la WAI-ARIA: flechas izquierda y derecha, Inicio y Fin; solo la
+ * pestaña elegida entra en el orden del tabulador.
+ * Sin JavaScript (no hay data-theme en <html>) no se ven las pestañas y salen los cuatro
+ * paneles uno debajo del otro, con su título.
+ */
+interface Chapter {
+  id: string;
+  title: string;
+  text: string;
+  rows: readonly { label: string; value: string }[];
+}
+
+interface Props {
+  chapters: readonly Chapter[];
+  note: string;
+  label: string;
+}
+
+const { chapters, note, label } = Astro.props;
+---
+
+<div class="chapters flex flex-col gap-6" data-chapters>
+  <div role="tablist" aria-label={label} class="chapters-list">
+    {chapters.map((chapter, index) => (
+      <button
+        type="button"
+        role="tab"
+        id={`tab-${chapter.id}`}
+        aria-controls={`panel-${chapter.id}`}
+        aria-selected={index === 0 ? 'true' : 'false'}
+        tabindex={index === 0 ? 0 : -1}
+        class="chapters-tab press"
+      >
+        {chapter.title}
+      </button>
+    ))}
+  </div>
+
+  {chapters.map((chapter, index) => (
+    <div
+      role="tabpanel"
+      id={`panel-${chapter.id}`}
+      aria-labelledby={`tab-${chapter.id}`}
+      tabindex="0"
+      class="chapters-panel grid gap-4 lg:grid-cols-2"
+      data-inactive={index !== 0 ? '' : undefined}
+    >
+      <div class="on-deep flex flex-col gap-4 rounded-panel p-7 sm:p-10">
+        <h3 class="text-3xl">{chapter.title}</h3>
+        <p class="text-lg text-muted">{chapter.text}</p>
+      </div>
+      <div class="chapters-rows flex flex-col gap-2.5 rounded-panel p-5 sm:p-7">
+        <dl class="flex flex-col gap-2.5">
+          {chapter.rows.map((row) => (
+            <div class="chapters-row">
+              <dt>{row.label}</dt>
+              <dd class="font-bold">{row.value}</dd>
+            </div>
+          ))}
+        </dl>
+        <p class="mt-1 text-sm text-muted">{note}</p>
+      </div>
+    </div>
+  ))}
+</div>
+
+<style>
+  .chapters-list {
+    display: flex;
+    flex-wrap: wrap;
+    align-self: flex-start;
+    gap: 0.375rem;
+    border: 1px solid var(--c-line);
+    border-radius: 1.125rem;
+    background-color: var(--c-surface);
+    padding: 0.375rem;
+  }
+
+  .chapters-tab {
+    min-height: 2.75rem;
+    border-radius: 0.875rem;
+    padding-inline: 1.25rem;
+    color: var(--c-text);
+    font-weight: 700;
+    cursor: pointer;
+  }
+
+  .chapters-tab:hover {
+    background-color: var(--c-inset);
+  }
+
+  .chapters-tab[aria-selected='true'] {
+    background-color: var(--c-accent);
+    color: var(--c-on-accent);
+    box-shadow: 0 8px 20px -10px color-mix(in srgb, var(--c-accent) 90%, transparent);
+  }
+
+  /* Renglones como en la app: superficie clara con tarjetas blancas (o la superficie en oscuro). */
+  .chapters-rows {
+    border: 1px solid var(--c-line);
+    background-color: var(--c-inset);
+  }
+
+  .chapters-row {
+    display: flex;
+    justify-content: space-between;
+    gap: 0.75rem;
+    border-radius: 1rem;
+    background-color: var(--c-surface);
+    padding: 0.875rem 1rem;
+  }
+
+  /*
+   * Los paneles no elegidos se ocultan solo con JavaScript (data-theme en <html>). Sin él no
+   * hay pestañas y se ven los cuatro paneles. No se usa el atributo hidden porque Tailwind lo
+   * oculta con !important.
+   */
+  :root[data-theme] .chapters-panel[data-inactive] {
+    display: none;
+  }
+  :root:not([data-theme]) .chapters-list {
+    display: none;
+  }
+</style>
+
+<script>
+  document.querySelectorAll<HTMLElement>('[data-chapters]').forEach((root) => {
+    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
+    const panels = tabs.map((tab) =>
+      document.getElementById(tab.getAttribute('aria-controls') ?? ''),
+    );
+
+    function select(index: number, focus: boolean) {
+      tabs.forEach((tab, i) => {
+        const on = i === index;
+        tab.setAttribute('aria-selected', on ? 'true' : 'false');
+        tab.tabIndex = on ? 0 : -1;
+        const panel = panels[i];
+        if (panel) {
+          panel.toggleAttribute('data-inactive', !on);
+          if (on) {
+            panel.classList.remove('pop');
+            void panel.offsetWidth;
+            panel.classList.add('pop');
+          }
+        }
+      });
+      if (focus) tabs[index]?.focus();
+    }
+
+    tabs.forEach((tab, index) => {
+      tab.addEventListener('click', () => select(index, false));
+      tab.addEventListener('keydown', (event) => {
+        const last = tabs.length - 1;
+        const next: Record<string, number> = {
+          ArrowRight: index === last ? 0 : index + 1,
+          ArrowLeft: index === 0 ? last : index - 1,
+          Home: 0,
+          End: last,
+        };
+        const target = next[event.key];
+        if (target === undefined) return;
+        event.preventDefault();
+        select(target, true);
+      });
+    });
+  });
+</script>
