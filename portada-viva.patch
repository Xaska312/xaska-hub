+  .register-open {
+    display: flex;
+    flex: 1;
+    flex-direction: column;
+    gap: 0.75rem;
+  }
+
+  .register-open[hidden],
+  .register-done[hidden],
+  .register-empty[hidden] {
+    display: none;
+  }
+
+  .register-clear {
+    border-radius: 0.75rem;
+    padding: 0.35rem 0.6rem;
+    color: var(--pos-brand);
+    font-size: 0.8125rem;
+    font-weight: 600;
+    cursor: pointer;
+  }
+
