+        </svg>
+        <p>Toca un producto para empezar la venta.</p>
+      </div>
+
+      <div class="register-open" data-state="cart" hidden>
+        <div class="flex items-center justify-between gap-2">
+          <p class="text-sm font-bold">Venta actual</p>
+          <button type="button" class="register-clear press" data-action="clear">
+            Vaciar
+          </button>
+        </div>
+        <ul class="flex flex-col gap-2 text-sm" data-lines></ul>
+        <div class="register-total">
+          <p class="flex items-baseline justify-between gap-2">
+            <span class="text-sm">Total</span>
+            <span class="text-[1.75rem] leading-none font-extrabold" data-total>
+              $0
+            </span>
+          </p>
+          <button type="button" class="register-pay press" data-action="pay">
+            Cobrar
+          </button>
+        </div>
+      </div>
+
+      <div class="register-done" data-state="paid" hidden>
+        <span class="register-check" aria-hidden="true">
+          <svg
+            width="28"
+            height="28"
+            viewBox="0 0 24 24"
+            fill="none"
+            stroke="currentColor"
