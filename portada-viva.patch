+    background-color: var(--pos-brand-soft);
+  }
+
+  .register-total {
+    display: flex;
+    flex-direction: column;
+    gap: 0.65rem;
+    margin-top: auto;
+    border-radius: 1rem;
+    background-color: var(--pos-brand-900);
+    padding: 0.875rem;
+    color: #ffffff;
+  }
+
+  .register-pay {
+    min-height: 3rem;
+    border-radius: 0.875rem;
+    background-color: var(--pos-light);
+    color: var(--pos-brand-950);
+    font-weight: 700;
+    cursor: pointer;
+    box-shadow: 0 8px 18px -8px rgb(129 140 248 / 0.9);
+  }
+
+  .register-pay:focus-visible {
+    outline-color: #ffffff;
+  }
+
+  .register-check {
+    display: inline-flex;
+    width: 3.5rem;
+    height: 3.5rem;
+    align-items: center;
+    justify-content: center;
+    border-radius: 9999px;
+    background-color: #d1fae5;
+    color: #047857;
+  }
+
+  .register-muted {
+    color: var(--pos-muted);
+  }
+
+  .register-note {
+    border-radius: 9999px;
+    background-color: #eef2ff;
+    padding: 0.4rem 0.75rem;
+    color: #3730a3;
+    font-size: 0.8125rem;
+    font-weight: 600;
+  }
+
+  .register-again {
+    min-height: 2.75rem;
+    border-radius: 0.875rem;
+    background-color: var(--pos-ink);
+    padding-inline: 1.1rem;
+    color: #ffffff;
+    font-weight: 600;
+    cursor: pointer;
+  }
+
+  .register-caption {
+    margin: 0.75rem 0.5rem 0.25rem;
+    color: #c7d2fe;
+    font-size: 0.8125rem;
+  }
+
+  @media (prefers-reduced-motion: no-preference) {
+    .register-tile:hover {
+      box-shadow: 0 10px 24px -14px rgb(67 56 202 / 0.6);
+    }
+    .register-tile:active {
+      transform: scale(0.94);
+    }
+  }
+</style>
+
+<script>
+  import { formatPesos } from '@/lib/money';
+
+  document.querySelectorAll<HTMLElement>('[data-register]').forEach((root) => {
+    const cart = new Map<string, { price: number; qty: number }>();
+    const views = {
+      empty: root.querySelector<HTMLElement>('[data-state="empty"]'),
+      cart: root.querySelector<HTMLElement>('[data-state="cart"]'),
+      paid: root.querySelector<HTMLElement>('[data-state="paid"]'),
+    };
+    const lines = root.querySelector<HTMLUListElement>('[data-lines]');
+    const total = root.querySelector<HTMLElement>('[data-total]');
+    const paid = root.querySelector<HTMLElement>('[data-paid]');
+    const announce = root.querySelector<HTMLElement>('[data-announce]');
+    const tiles = [...root.querySelectorAll<HTMLButtonElement>('button[data-name]')];
+    if (!views.empty || !views.cart || !views.paid || !lines || !total || !paid || !announce) {
+      return;
+    }
+
+    const sum = () => [...cart.values()].reduce((acc, line) => acc + line.price * line.qty, 0);
+
+    function show(view: keyof typeof views) {
+      for (const [name, element] of Object.entries(views)) {
+        if (element) element.hidden = name !== view;
+      }
+    }
+
+    /** La animación vuelve a correr aunque el elemento ya la tuviera. */
+    function pop(element: Element) {
+      element.classList.remove('pop');
+      void (element as HTMLElement).offsetWidth;
+      element.classList.add('pop');
+    }
+
+    function render(changed?: string) {
+      if (cart.size === 0) {
+        show('empty');
+        return;
+      }
+      show('cart');
+      lines?.replaceChildren(
+        ...[...cart.entries()].map(([name, line]) => {
+          const item = document.createElement('li');
+          item.className = 'flex justify-between gap-2';
+          if (name === changed) item.classList.add('pop');
+          const label = document.createElement('span');
+          label.textContent = `${line.qty} × ${name}`;
+          const value = document.createElement('strong');
+          value.textContent = formatPesos(line.price * line.qty);
+          item.append(label, value);
+          return item;
+        }),
+      );
+      if (total) {
+        total.textContent = formatPesos(sum());
+        pop(total);
+      }
+    }
+
+    tiles.forEach((tile) => {
+      tile.addEventListener('click', () => {
+        const name = tile.dataset.name ?? '';
+        const price = Number(tile.dataset.price);
+        if (!name || !Number.isFinite(price)) return;
+        const line = cart.get(name) ?? { price, qty: 0 };
+        line.qty += 1;
+        cart.set(name, line);
+        render(name);
+        announce.textContent = `${name} agregado. Total ${formatPesos(sum())}.`;
+      });
+    });
+
+    root.querySelector('[data-action="pay"]')?.addEventListener('click', () => {
+      const amount = sum();
+      cart.clear();
+      paid.textContent = formatPesos(amount);
+      show('paid');
+      pop(views.paid as HTMLElement);
+      announce.textContent = `Venta registrada: ${formatPesos(amount)} en efectivo.`;
+      root.querySelector<HTMLButtonElement>('[data-action="reset"]')?.focus();
+    });
+
+    root.querySelector('[data-action="clear"]')?.addEventListener('click', () => {
+      cart.clear();
+      render();
+      announce.textContent = 'Venta vacía.';
+      tiles[0]?.focus();
+    });
+
+    root.querySelector('[data-action="reset"]')?.addEventListener('click', () => {
+      render();
+      announce.textContent = 'Nueva venta. Toca un producto para empezar.';
+      tiles[0]?.focus();
+    });
+  });
+</script>
