{
  "name": "xaska-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Sitio corporativo de XASKA (xaska.co)",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=12.15.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-pendientes.ts",
    "preview": "pnpm build && wrangler dev",
    "check": "astro check && tsc -p worker",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:install": "playwright install chromium",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm build && pnpm test",
    "pendientes": "node scripts/check-pendientes.ts --write",
    "types:worker": "wrangler types worker/worker-configuration.d.ts --include-env=false",
    "lighthouse": "node scripts/lighthouse.ts",
    "og:image": "node scripts/generate-og-image.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "lighthouse": "13.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "wrangler": "4.152.0"
  }
}
