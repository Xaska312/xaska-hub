# Variables de build (Astro). En Cloudflare: Settings → Build → Variables.
# Clave pública (site key) del widget de Turnstile. Si falta, en pruebas se usa la de prueba de Cloudflare
# y en producción el build falla.
PUBLIC_TURNSTILE_SITE_KEY=

# Token del sitio en Cloudflare Web Analytics (es público: va en el HTML). Solo se usa si
# ANALYTICS es true en src/config/site.ts. Con la bandera en true y sin token, el build de producción falla.
PUBLIC_CF_ANALYTICS_TOKEN=

# Fuerza el modo del build: "production" o "preview". Normalmente no hace falta (se detecta la rama main).
# XASKA_ENV=

# Los secretos del Worker (RESEND_API_KEY, TURNSTILE_SECRET_KEY) NO van aquí:
# en Cloudflare van en Settings → Variables and Secrets, y en local en .dev.vars (ver .dev.vars.example).
