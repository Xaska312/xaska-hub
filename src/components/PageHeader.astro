---
/**
 * Encabezado de página en estilo bento, con el único h1.
 *
 * Una tarjeta grande (destacada en degradado índigo, o profunda como el ingreso al POS) con
 * el título, y a la derecha tarjetas propias de cada página.
 *
 * - `trail`: migas de pan antes de la página actual.
 * - `badge`: etiqueta corta arriba a la derecha de la tarjeta (p. ej. "Hecho en Ibagué").
 * - `slogan`: lema bajo el título; la última palabra va resaltada.
 * - `tone`: "feature" (degradado índigo claro) o "deep" (índigo profundo).
 * - `word`: palabra gigante cortada al pie de la tarjeta (p. ej. "POS"). Decorativa.
 * - slot por defecto: acciones (botones) bajo la entrada.
 * - slot "visual": tarjetas a la derecha en escritorio (debajo en celular).
 * - slot "below": contenido a lo ancho bajo el encabezado.
 */
interface Props {
  title: string;
  lead: string;
  trail?: { label: string; href: string }[] | undefined;
  badge?: string | undefined;
  /** Lema opcional bajo el título (p. ej. "Vende. Fía. Cobra. Controla."). La última palabra va resaltada. */
  slogan?: readonly string[] | undefined;
  tone?: 'feature' | 'deep' | undefined;
  word?: string | undefined;
}

const { title, lead, trail, badge, slogan, tone = 'feature', word } = Astro.props;
const sloganHead = slogan?.slice(0, -1) ?? [];
const sloganLast = slogan?.at(-1);
const hasVisual = Astro.slots.has('visual');
---

<section class="pt-4 pb-2 sm:pt-8">
  <div class="mx-auto w-full max-w-(--container-page) px-4 sm:px-6 lg:px-8">
    <div class:list={['grid gap-4', hasVisual && 'lg:grid-cols-12']}>
      <div
        class:list={[
          tone === 'deep' ? 'on-deep' : 'on-feature',
          'relative flex min-h-[26rem] flex-col justify-between gap-10 overflow-hidden rounded-panel p-6 sm:min-h-[32rem] sm:p-10',
          hasVisual && 'lg:col-span-7',
        ]}
      >
        <div class="flex flex-wrap items-start justify-between gap-4">
          {trail && trail.length > 0 ? (
            <nav aria-label="Ruta" class="text-sm text-muted">
              <ol class="flex flex-wrap items-center gap-2">
                {trail.map((item) => (
                  <li class="flex items-center gap-2">
                    <a href={item.href} class="underline-offset-4 hover:underline">
                      {item.label}
                    </a>
                    <span aria-hidden="true">/</span>
                  </li>
                ))}
                <li aria-current="page" class="font-semibold text-ink">
                  {title}
                </li>
              </ol>
            </nav>
          ) : (
            <span class="rombo mt-2 text-lg" aria-hidden="true" />
          )}
          {badge && <span class="chip">{badge}</span>}
        </div>

        <div class="relative">
          <h1 class="max-w-[16ch] text-[2.5rem] leading-[1.04] sm:text-5xl lg:text-[3.6rem] lg:leading-[1.02]">
            {title}
          </h1>
          {sloganLast && (
            <p class="mt-4 text-2xl font-extrabold tracking-tight sm:text-3xl" data-slogan>
              {sloganHead.map((item) => `${item} `)}
              <span class="text-accent">{sloganLast}</span>
            </p>
          )}
          <p class="mt-5 max-w-[52ch] text-lg font-medium text-muted">{lead}</p>
          {Astro.slots.has('default') && (
            <div class="mt-8 flex flex-wrap items-center gap-3">
              <slot />
            </div>
          )}
        </div>

        {word && (
          <p
            aria-hidden="true"
            class="giant-word -mx-2 -mb-6 h-[0.62em] overflow-hidden text-[7rem] sm:-mb-10 sm:text-[11rem]"
          >
            {word}
          </p>
        )}
      </div>

      {hasVisual && (
        <div class="flex min-w-0 flex-col gap-4 lg:col-span-5">
          <slot name="visual" />
        </div>
      )}
    </div>

    {Astro.slots.has('below') && (
      <div class="mt-4">
        <slot name="below" />
      </div>
    )}
  </div>
</section>
