---
/**
 * Bloque de página con ancho y espaciado vertical consistentes.
 * En el estilo bento el fondo de la página es uno solo: los bloques se distinguen por sus
 * tarjetas, no por bandas de color.
 */
interface Props {
  id?: string | undefined;
  labelledby?: string | undefined;
  class?: string | undefined;
}

const { id, labelledby, class: className } = Astro.props;
---

<section id={id} aria-labelledby={labelledby} class:list={['py-8 sm:py-12', className]}>
  <div class="mx-auto w-full max-w-(--container-page) px-4 sm:px-6 lg:px-8">
    <slot />
  </div>
</section>
