---
/**
 * Ilustración interactiva de una tienda: la estantería y la caja. Cada producto tocado pasa a la
 * caja como si lo leyera el lector, y el pago puede ser en efectivo o fiado dentro del cupo del
 * cliente (en XASKA POS el cupo no se supera sin permiso). Productos y precios de ejemplo.
 */
import { formatPesos } from '@/lib/money';

const rows = [
  [
    { name: 'Arroz 1 kg', price: 4200, tone: 'amber' },
    { name: 'Leche 1 L', price: 4600, tone: 'sky' },
    { name: 'Panela', price: 2600, tone: 'orange' },
  ],
  [
    { name: 'Cuaderno', price: 4500, tone: 'violet' },
    { name: 'Lapicero', price: 1200, tone: 'green' },
    { name: 'Fotocopia', price: 200, tone: 'slate' },
  ],
  [
    { name: 'Gaseosa', price: 5900, tone: 'rose' },
    { name: 'Huevos x 12', price: 13800, tone: 'yellow' },
    { name: 'Café 250 g', price: 11900, tone: 'gold' },
  ],
];
const creditLimit = 107700;
---

<div class="st" data-store data-limit={creditLimit}>
  <div class="seg-blob st-blob" aria-hidden="true"></div>
  <div class="st-inner">
    <div class="st-shelf">
      <p class="st-label">Estantería · toca un producto</p>
      {rows.map((row) => (
        <div class="st-row">
          {row.map((item) => (
            <button
              type="button"
              class:list={['st-item press', `st-${item.tone}`]}
              data-name={item.name}
              data-price={item.price}
              aria-label={`Agregar ${item.name}, ${formatPesos(item.price)}`}
            >
              <span class="st-item-name">{item.name}</span>
              <span class="st-item-price">{formatPesos(item.price)}</span>
            </button>
          ))}
        </div>
      ))}
    </div>

    <div class="st-register pos-frame">
      <div class="pos-screen st-screen">
        <p class="font-bold">Caja</p>
        <p class="st-empty" data-empty>
          Toca un producto de la estantería.
        </p>
        <ul class="st-lines" data-lines aria-live="polite"></ul>
        <div class="st-pay">
          <p class="st-total">
            <span>Total</span>
            <strong data-total>$0</strong>
          </p>
          <div class="st-modes" role="group" aria-label="Medio de pago">
            <button type="button" class="st-mode press" data-mode="cash" aria-pressed="true">
              Efectivo
            </button>
            <button type="button" class="st-mode press" data-mode="credit" aria-pressed="false">
              Fiar a Doña Rosa
            </button>
          </div>
          <p class="st-note" data-note>
            Efectivo, transferencia o las dos.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
<p class="mt-3 text-sm text-muted">Ilustración con productos y precios de ejemplo.</p>

<style>
  .st {
    position: relative;
  }
  .st-blob {
    position: absolute;
    inset: 0 0.625rem 1.25rem 0;
  }
  .st-inner {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 1.125rem;
    padding: 1.5rem 1rem;
  }
  .st-shelf {
    display: flex;
    min-width: 0;
    flex: 1 1 17rem;
    flex-direction: column;
    gap: 0.75rem;
    border-radius: 1.6rem;
    background-color: var(--c-surface);
    padding: 1rem;
    box-shadow: 0 24px 40px -30px var(--seg-deep);
  }
  .st-label {
    color: var(--c-muted);
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .st-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    border-bottom: 6px solid var(--seg-soft);
    border-radius: 0 0 4px 4px;
    padding-bottom: 0.625rem;
  }
  .st-item {
    display: flex;
    min-height: 4.625rem;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.25rem;
    border-radius: 0.875rem;
    padding: 0.625rem;
    color: #111827;
    text-align: left;
    cursor: pointer;
  }
  .st-item-name {
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }
  .st-item-price {
    font-size: 0.75rem;
    font-weight: 800;
  }
  .st-amber {
    background: #fef3c7;
  }
  .st-sky {
    background: #e0f2fe;
  }
  .st-orange {
    background: #ffedd5;
  }
  .st-violet {
    background: #ede9fe;
  }
  .st-green {
    background: #dcfce7;
  }
  .st-slate {
    background: #f1f5f9;
  }
  .st-rose {
    background: #ffe4e6;
  }
  .st-yellow {
    background: #fef9c3;
  }
  .st-gold {
    background: #fde68a;
  }
  .st-register {
    min-width: 0;
    flex: 1 1 15rem;
  }
  .st-screen {
    display: flex;
    min-height: 18.75rem;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.875rem;
    font-size: 0.875rem;
  }
  .st-empty {
    padding: 1.25rem 0;
    color: #4b5563;
    font-size: 0.8125rem;
  }
  .st-empty[hidden] {
    display: none;
  }
  .st-lines {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .st-lines :global(li) {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    border-radius: 0.625rem;
    background-color: #ffffff;
    padding: 0.5rem 0.625rem;
    font-size: 0.8125rem;
  }
  .st-pay {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: auto;
    border-radius: 0.875rem;
    background-color: #312e81;
    padding: 0.75rem;
    color: #ffffff;
  }
  .st-total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    font-size: 0.8125rem;
  }
  .st-total strong {
    font-size: 1.5rem;
    font-weight: 800;
  }
  .st-modes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.375rem;
  }
  .st-mode {
    min-height: 2.75rem;
    border-radius: 0.625rem;
    background-color: rgb(255 255 255 / 0.12);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
  }
  .st-mode[aria-pressed='true'] {
    background-color: #a5b4fc;
    color: #1e1b4b;
  }
  .st-note {
    color: #c7d2fe;
    font-size: 0.75rem;
  }
  @media (min-width: 640px) {
    .st-inner {
      padding: 2.5rem 1.875rem;
    }
  }
</style>

<script>
  import { formatPesos } from '@/lib/money';

  document.querySelectorAll<HTMLElement>('[data-store]').forEach((root) => {
    const limit = Number(root.dataset.limit) || 0;
    const cart = new Map<string, { price: number; qty: number }>();
    let credit = false;
    const linesOut = root.querySelector<HTMLUListElement>('[data-lines]');
    const emptyOut = root.querySelector<HTMLElement>('[data-empty]');
    const totalOut = root.querySelector<HTMLElement>('[data-total]');
    const noteOut = root.querySelector<HTMLElement>('[data-note]');
    const modes = [...root.querySelectorAll<HTMLButtonElement>('[data-mode]')];

    function render() {
      let total = 0;
      const items: HTMLLIElement[] = [];
      cart.forEach((line, name) => {
        total += line.price * line.qty;
        const li = document.createElement('li');
        const label = document.createElement('span');
        label.textContent = `${line.qty} × ${name}`;
        const value = document.createElement('strong');
        value.textContent = formatPesos(line.price * line.qty);
        li.append(label, value);
        items.push(li);
      });
      linesOut?.replaceChildren(...items);
      if (emptyOut) emptyOut.hidden = cart.size > 0;
      if (totalOut) totalOut.textContent = formatPesos(total);
      if (noteOut) {
        noteOut.textContent = credit
          ? `Cupo disponible de Doña Rosa: ${formatPesos(Math.max(0, limit - total))}`
          : 'Efectivo, transferencia o las dos.';
      }
    }

    root.querySelectorAll<HTMLButtonElement>('.st-item').forEach((button) => {
      button.addEventListener('click', () => {
        const name = button.dataset.name ?? '';
        const price = Number(button.dataset.price) || 0;
        const line = cart.get(name);
        cart.set(name, { price, qty: (line?.qty ?? 0) + 1 });
        render();
      });
    });

    modes.forEach((button) => {
      button.addEventListener('click', () => {
        credit = button.dataset.mode === 'credit';
        modes.forEach((other) =>
          other.setAttribute('aria-pressed', other === button ? 'true' : 'false'),
        );
        render();
      });
    });
  });
</script>
