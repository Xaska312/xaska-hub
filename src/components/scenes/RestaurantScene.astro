---
/**
 * Ilustración interactiva de un restaurante o bar: la barra, las mesas y la tablet con la cuenta.
 * Cada toque a una mesa cambia su estado (libre → en cocina → comiendo → pidió la cuenta), como
 * en XASKA POS (decisión 284 del POS), y la tablet muestra su cuenta dividida con la propina
 * sugerida del 10 % (decisión 272). Datos de ejemplo. Sin JavaScript se ve el estado inicial.
 */
import { formatPesos } from '@/lib/money';

const states = ['Libre', 'En cocina', 'Comiendo', 'Pidió la cuenta'];
const tables = [
  { name: 'Mesa 2', state: 1, amount: 48500, round: true },
  { name: 'Mesa 3', state: 2, amount: 72000, round: true },
  { name: 'Mesa 1', state: 0, amount: 0, round: false },
  { name: 'Mesa 4', state: 3, amount: 35900, round: true },
  { name: 'Barra 1', state: 2, amount: 118400, round: false },
];
const selected = 3;
const first = tables[selected] ?? { name: '', amount: 0 };
const tip = Math.round(first.amount * 0.1);
---

<div class="rs-wrap">
  <div class="rs" data-restaurant>
    <div class="seg-blob rs-blob" aria-hidden="true"></div>
    <div class="rs-bar" aria-hidden="true">
      <span class="rs-bar-label">Barra</span>
      <div class="rs-bottles">
        <span class="rs-bottle rs-b1"></span>
        <span class="rs-bottle rs-b2"></span>
        <span class="rs-bottle rs-b3"></span>
        <span class="rs-bottle rs-b4"></span>
        <span class="rs-bottle rs-b5"></span>
        <span class="rs-bar-note">La barra recibe sus pedidos</span>
      </div>
    </div>

    <ul class="rs-tables" aria-label="Mesas de ejemplo: toca una para cambiar su estado">
      {tables.map((table, index) => (
        <li class:list={['rs-spot', `rs-spot-${index + 1}`]}>
          <button
            type="button"
            class:list={['rs-table press', table.round ? 'rs-round' : 'rs-square']}
            data-index={index}
            data-state={table.state}
            data-amount={table.amount}
            data-selected={index === selected ? '' : undefined}
            aria-pressed={index === selected ? 'true' : 'false'}
          >
            <span class="rs-name">{table.name}</span>
            <span class="rs-state">{states[table.state]}</span>
          </button>
        </li>
      ))}
    </ul>

    <div class="rs-tablet pos-frame">
      <div class="pos-screen rs-bill">
        <p class="font-bold">
          Cuenta · <span data-bill-name>{first.name}</span>
        </p>
        <p class="rs-line">
          <span>Consumo</span>
          <strong data-bill-amount>{formatPesos(first.amount)}</strong>
        </p>
        <p class="rs-line">
          <span>Propina sugerida 10 %</span>
          <strong data-bill-tip>{formatPesos(tip)}</strong>
        </p>
        <div class="rs-splits" role="group" aria-label="Dividir la cuenta">
          {[1, 2, 3, 4].map((parts) => (
            <button
              type="button"
              class="rs-split press"
              data-split={parts}
              aria-pressed={parts === 1 ? 'true' : 'false'}
            >
              {parts === 1 ? 'Toda' : `÷ ${parts}`}
            </button>
          ))}
        </div>
        <p class="rs-total" aria-live="polite" data-bill-per>
          Total {formatPesos(first.amount + tip)}
        </p>
      </div>
    </div>
  </div>
</div>
<p class="mt-3 text-sm text-muted">Ilustración con datos de ejemplo.</p>

<style>
  .rs-wrap {
    container-type: inline-size;
  }
  .rs {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
  }
  .rs-blob {
    position: absolute;
    inset: 0;
  }
  .rs-bar,
  .rs-tables,
  .rs-tablet {
    position: relative;
  }
  .rs-bar {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    border-radius: 1.6rem;
    background-color: var(--seg-deep);
    padding: 1rem 1.25rem;
  }
  .rs-bar-label {
    color: rgb(255 255 255 / 0.8);
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .rs-bottles {
    display: flex;
    align-items: flex-end;
    gap: 0.6rem;
    min-height: 4rem;
  }
  .rs-bottle {
    width: 1rem;
    border-radius: 0.5rem 0.5rem 0.25rem 0.25rem;
  }
  .rs-b1 {
    height: 3.6rem;
    background: #fda4af;
  }
  .rs-b2 {
    height: 2.75rem;
    background: #fbbf24;
  }
  .rs-b3 {
    height: 4rem;
    background: #a7f3d0;
  }
  .rs-b4 {
    height: 3.1rem;
    background: #fda4af;
  }
  .rs-b5 {
    height: 2.4rem;
    background: #c4b5fd;
  }
  .rs-bar-note {
    margin-left: auto;
    border-radius: 0.75rem;
    background-color: rgb(255 255 255 / 0.14);
    padding: 0.5rem 0.75rem;
    color: #ffffff;
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .rs-tables {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .rs-table {
    display: flex;
    width: 100%;
    min-height: 6rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    border: 4px solid var(--rs-ring, #34d399);
    background-color: var(--c-surface);
    color: var(--c-text);
    text-align: center;
    cursor: pointer;
    box-shadow: 0 12px 24px -16px rgb(0 0 0 / 0.5);
    transition:
      transform 220ms var(--ease-bounce),
      box-shadow 200ms,
      border-color 200ms;
  }
  .rs-round {
    border-radius: 1.5rem;
  }
  .rs-square {
    border-radius: 1.5rem;
  }
  .rs-table[data-selected] {
    box-shadow: 0 0 0 4px var(--c-text);
  }
  .rs-table[data-state='0'] {
    --rs-ring: #34d399;
    --rs-ink: #047857;
  }
  .rs-table[data-state='1'] {
    --rs-ring: #fbbf24;
    --rs-ink: #92400e;
  }
  .rs-table[data-state='2'] {
    --rs-ring: #a78bfa;
    --rs-ink: #5b21b6;
  }
  .rs-table[data-state='3'] {
    --rs-ring: #fb7185;
    --rs-ink: #9f1239;
  }
  :global(:root[data-theme='dark']) .rs-table[data-state='0'] {
    --rs-ink: #6ee7b7;
  }
  :global(:root[data-theme='dark']) .rs-table[data-state='1'] {
    --rs-ink: #fcd34d;
  }
  :global(:root[data-theme='dark']) .rs-table[data-state='2'] {
    --rs-ink: #c4b5fd;
  }
  :global(:root[data-theme='dark']) .rs-table[data-state='3'] {
    --rs-ink: #fda4af;
  }
  .rs-name {
    font-weight: 800;
  }
  .rs-state {
    color: var(--rs-ink);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .rs-bill {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.875rem;
    font-size: 0.875rem;
  }
  .rs-line {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.8125rem;
  }
  .rs-splits {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.375rem;
  }
  .rs-split {
    min-height: 2.75rem;
    border-radius: 0.625rem;
    background-color: #ffffff;
    color: #111827;
    font-size: 0.8125rem;
    font-weight: 700;
    cursor: pointer;
  }
  .rs-split[aria-pressed='true'] {
    background-color: var(--pos-brand-900);
    color: #ffffff;
  }
  .rs-total {
    border-radius: 0.75rem;
    background-color: #be123c;
    padding: 0.625rem;
    color: #ffffff;
    font-weight: 800;
    text-align: center;
  }

  /* Con espacio suficiente, el plano del local: mesas repartidas sobre la forma. */
  @container (min-width: 42rem) {
    .rs {
      display: block;
      min-height: 37.5rem;
      padding: 0;
    }
    .rs-blob {
      inset: 0.625rem 0 0 1.25rem;
    }
    .rs-bar {
      position: absolute;
      top: 2.25rem;
      right: 3.75rem;
      left: 3.75rem;
    }
    .rs-tables {
      position: static;
      display: block;
    }
    .rs-spot {
      position: absolute;
      width: 7.25rem;
    }
    .rs-table {
      height: 7.25rem;
    }
    .rs-round {
      border-radius: 50%;
    }
    .rs-spot-1 {
      top: 13.75rem;
      left: 4.375rem;
    }
    .rs-spot-2 {
      top: 18.75rem;
      left: 13.75rem;
    }
    .rs-spot-3 {
      top: 25rem;
      left: 5.625rem;
    }
    .rs-spot-4 {
      top: 13.125rem;
      left: 23.75rem;
    }
    .rs-spot-5 {
      top: 29.375rem;
      left: 15.625rem;
    }
    .rs-tablet {
      position: absolute;
      right: 1.125rem;
      bottom: 1.125rem;
      width: 17rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .rs-table:active {
      transform: scale(0.93);
    }
  }
</style>

<script>
  import { formatPesos } from '@/lib/money';

  const STATES = ['Libre', 'En cocina', 'Comiendo', 'Pidió la cuenta'];

  document.querySelectorAll<HTMLElement>('[data-restaurant]').forEach((root) => {
    const tables = [...root.querySelectorAll<HTMLButtonElement>('.rs-table')];
    const splits = [...root.querySelectorAll<HTMLButtonElement>('[data-split]')];
    const nameOut = root.querySelector<HTMLElement>('[data-bill-name]');
    const amountOut = root.querySelector<HTMLElement>('[data-bill-amount]');
    const tipOut = root.querySelector<HTMLElement>('[data-bill-tip]');
    const perOut = root.querySelector<HTMLElement>('[data-bill-per]');
    let selected = tables.findIndex((table) => table.hasAttribute('data-selected'));
    let parts = 1;

    function renderBill() {
      const table = tables[selected];
      if (!table) return;
      const amount = Number(table.dataset.amount) || 0;
      const tip = Math.round(amount * 0.1);
      if (nameOut) nameOut.textContent = table.querySelector('.rs-name')?.textContent ?? '';
      if (amountOut) amountOut.textContent = formatPesos(amount);
      if (tipOut) tipOut.textContent = formatPesos(tip);
      if (perOut) {
        perOut.textContent = `${parts === 1 ? 'Total' : 'Cada uno'} ${formatPesos((amount + tip) / parts)}`;
      }
    }

    tables.forEach((table, index) => {
      table.addEventListener('click', () => {
        const next = ((Number(table.dataset.state) || 0) + 1) % STATES.length;
        table.dataset.state = String(next);
        if (next === 0) table.dataset.amount = '0';
        if (next === 1 && Number(table.dataset.amount) === 0) {
          table.dataset.amount = String(31000 + index * 6400);
        }
        const label = table.querySelector('.rs-state');
        if (label) label.textContent = STATES[next] ?? '';
        tables.forEach((other, i) => {
          other.toggleAttribute('data-selected', i === index);
          other.setAttribute('aria-pressed', i === index ? 'true' : 'false');
        });
        selected = index;
        renderBill();
      });
    });

    splits.forEach((button) => {
      button.addEventListener('click', () => {
        parts = Number(button.dataset.split) || 1;
        splits.forEach((other) =>
          other.setAttribute('aria-pressed', other === button ? 'true' : 'false'),
        );
        renderBill();
      });
    });
  });
</script>
