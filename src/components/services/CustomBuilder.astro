---
/**
 * Desarrollo a medida: el visitante toca piezas (pedidos, inventario, portal…) y arma un plano de
 * su programa. El mensaje de WhatsApp se escribe solo con las piezas elegidas.
 */
import { whatsappUrl } from '@/config/site';

interface Props {
  cta: string;
}
const { cta } = Astro.props;

const parts = [
  {
    key: 'pedidos',
    label: 'Pedidos',
    text: 'Del pedido a la entrega, con su estado.',
    tone: 'violet',
  },
  {
    key: 'inventario',
    label: 'Inventario',
    text: 'Lo que entra, sale y queda, por bodega.',
    tone: 'indigo',
  },
  {
    key: 'produccion',
    label: 'Producción',
    text: 'Qué se fabrica, con qué y cuándo está listo.',
    tone: 'pink',
  },
  {
    key: 'portal',
    label: 'Portal para clientes',
    text: 'Tus clientes consultan o hacen pedidos.',
    tone: 'green',
  },
  { key: 'agenda', label: 'Agenda', text: 'Turnos, citas y quién atiende a quién.', tone: 'amber' },
  {
    key: 'reportes',
    label: 'Reportes',
    text: 'Las cifras de la semana, sin armarlas a mano.',
    tone: 'sky',
  },
  { key: 'avisos', label: 'Avisos', text: 'Correos o mensajes cuando algo cambia.', tone: 'rose' },
  {
    key: 'usuarios',
    label: 'Usuarios y permisos',
    text: 'Cada persona ve lo que le toca.',
    tone: 'slate',
  },
];
const initial = new Set(['pedidos', 'inventario', 'portal']);
const chosen = parts.filter((part) => initial.has(part.key));

function message(labels: string[]) {
  const names = labels.map((label) => label.toLowerCase());
  if (names.length === 0) return 'Hola, quiero hablar de un programa a la medida.';
  const list =
    names.length > 1 ? `${names.slice(0, -1).join(', ')} y ${names[names.length - 1]}` : names[0];
  return `Hola, quiero un programa a la medida con ${list}.`;
}
const firstMessage = message(chosen.map((part) => part.label));
---

<div class="cb" data-builder data-wa={whatsappUrl()}>
  <div class="cb-side">
    <p class="cb-title">Piezas</p>
    <div class="cb-parts" role="group" aria-label="Piezas del programa">
      {parts.map((part) => (
        <button
          type="button"
          class="cb-part press"
          data-key={part.key}
          aria-pressed={initial.has(part.key) ? 'true' : 'false'}
        >
          {part.label}
        </button>
      ))}
    </div>
    <div class="cb-bubble">
      <p class="cb-bubble-label">Tu mensaje de WhatsApp</p>
      <p data-message>{firstMessage}</p>
    </div>
    <a
      class="cb-send press-solid seg-solid"
      href={whatsappUrl(firstMessage)}
      target="_blank"
      rel="noopener"
      data-send
    >
      {cta}
      <span class="sr-only"> (se abre en una pestaña nueva)</span>
    </a>
  </div>

  <div class="cb-plan">
    <p class="cb-plan-head">
      <span>Plano de tu programa</span>
      <span class="cb-count" aria-live="polite" data-count>
        {chosen.length} piezas
      </span>
    </p>
    <p class="cb-empty" data-empty hidden>
      Toca una pieza y aparece en el plano.
    </p>
    <ul class="cb-grid" data-grid>
      {parts.map((part) => (
        <li
          class:list={['cb-piece', `cb-${part.tone}`]}
          data-piece={part.key}
          hidden={!initial.has(part.key)}
        >
          <span class="cb-piece-name">{part.label}</span>
          <span class="cb-piece-text">{part.text}</span>
        </li>
      ))}
    </ul>
    <p class="cb-note">
      Plano de ejemplo: el programa real se diseña contigo, empezando por lo que más tiempo te
      quita.
    </p>
  </div>
</div>

<style>
  .cb {
    display: flex;
    flex-wrap: wrap;
    gap: 1.125rem;
  }
  .cb-side {
    display: flex;
    min-width: 0;
    flex: 1 1 20rem;
    flex-direction: column;
    gap: 0.875rem;
  }
  .cb-title {
    font-size: 1.125rem;
    font-weight: 800;
  }
  .cb-parts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }
  .cb-part {
    min-height: 2.875rem;
    border-radius: 0.875rem;
    background-color: var(--c-surface);
    padding: 0 1rem;
    color: var(--c-text);
    font-size: 0.9375rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: inset 0 0 0 1.5px var(--seg-soft);
  }
  .cb-part[aria-pressed='true'] {
    background-color: var(--seg);
    color: var(--seg-on);
    box-shadow: 0 10px 20px -12px var(--seg);
  }
  .cb-bubble {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin-top: 0.5rem;
    border-radius: 1.4rem 1.4rem 1.4rem 0.375rem;
    background-color: #ffffff;
    padding: 1rem;
    color: #1a1033;
    font-size: 0.9375rem;
    line-height: 1.55;
    box-shadow: 0 18px 36px -28px #2e1065;
  }
  .cb-bubble-label {
    color: #047857;
    font-size: 0.75rem;
    font-weight: 700;
  }
  .cb-send {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    align-self: flex-start;
    border-radius: 0.875rem;
    padding: 0 1.375rem;
    font-weight: 700;
  }
  .cb-plan {
    display: flex;
    min-width: 0;
    min-height: 24rem;
    flex: 2 1 30rem;
    flex-direction: column;
    gap: 0.875rem;
    border-radius: 2.1rem;
    background-color: #2e1065;
    background-image: radial-gradient(rgb(196 181 253 / 0.28) 1.4px, transparent 1.4px);
    background-size: 22px 22px;
    padding: 1.375rem;
    color: #ede9fe;
  }
  .cb-plan-head {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-weight: 800;
  }
  .cb-count {
    margin-left: auto;
    color: #c4b5fd;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .cb-empty {
    flex: 1;
    align-content: center;
    color: #c4b5fd;
    text-align: center;
  }
  .cb-empty[hidden],
  .cb-piece[hidden] {
    display: none;
  }
  .cb-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr));
    gap: 0.75rem;
  }
  .cb-piece {
    display: flex;
    min-height: 6.875rem;
    flex-direction: column;
    gap: 0.375rem;
    border-radius: 1.4rem 0.5rem 1.4rem 1.4rem;
    padding: 1rem;
    color: #1a1033;
    animation: pop 380ms var(--ease-bounce) both;
  }
  .cb-piece:nth-child(even) {
    border-radius: 1.4rem 1.4rem 1.4rem 0.5rem;
  }
  .cb-piece-name {
    font-weight: 800;
  }
  .cb-piece-text {
    color: #4c3f6b;
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .cb-violet {
    background: #ede9fe;
  }
  .cb-indigo {
    background: #e0e7ff;
  }
  .cb-pink {
    background: #fce7f3;
  }
  .cb-green {
    background: #dcfce7;
  }
  .cb-amber {
    background: #fef3c7;
  }
  .cb-sky {
    background: #e0f2fe;
  }
  .cb-rose {
    background: #ffe4e6;
  }
  .cb-slate {
    background: #f1f5f9;
  }
  .cb-note {
    margin-top: auto;
    color: #c4b5fd;
    font-size: 0.75rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .cb-piece {
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-builder]').forEach((root) => {
    const base = root.dataset.wa ?? '';
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-key]')];
    const pieces = new Map(
      [...root.querySelectorAll<HTMLElement>('[data-piece]')].map((piece) => [
        piece.dataset.piece,
        piece,
      ]),
    );
    const out = (name: string) => root.querySelector<HTMLElement>(`[data-${name}]`);

    function render() {
      const labels: string[] = [];
      buttons.forEach((button) => {
        const on = button.getAttribute('aria-pressed') === 'true';
        const piece = pieces.get(button.dataset.key);
        if (piece) piece.hidden = !on;
        if (on) labels.push(button.textContent?.trim() ?? '');
      });
      const names = labels.map((label) => label.toLowerCase());
      const list =
        names.length > 1
          ? `${names.slice(0, -1).join(', ')} y ${names[names.length - 1]}`
          : names[0];
      const text = names.length
        ? `Hola, quiero un programa a la medida con ${list}.`
        : 'Hola, quiero hablar de un programa a la medida.';
      const message = out('message');
      if (message) message.textContent = text;
      const send = out('send');
      if (send) send.setAttribute('href', `${base}?text=${encodeURIComponent(text)}`);
      const count = out('count');
      if (count) count.textContent = labels.length === 1 ? '1 pieza' : `${labels.length} piezas`;
      const empty = out('empty');
      if (empty) empty.hidden = labels.length > 0;
    }

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        button.setAttribute(
          'aria-pressed',
          button.getAttribute('aria-pressed') === 'true' ? 'false' : 'true',
        );
        render();
      });
    });
  });
</script>
