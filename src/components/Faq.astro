---
/**
 * Preguntas frecuentes con <details>: accesibles con teclado y lectores de pantalla, sin JavaScript.
 * Cada pregunta es una tarjeta que se abre.
 */
interface Props {
  title: string;
  items: { question: string; answer: string }[];
  headingId?: string | undefined;
}

const { title, items, headingId = 'preguntas' } = Astro.props;
---

<div>
  <h2 id={headingId} class="text-3xl sm:text-4xl">
    {title}
  </h2>
  <div class="mt-8 grid gap-3">
    {items.map((item) => (
      <details class="faq bento group rounded-block">
        <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-6 px-6 py-4 text-lg font-semibold">
          <span>{item.question}</span>
          <span class="faq-toggle" aria-hidden="true" />
        </summary>
        <p class="max-w-(--container-prose) px-6 pb-6 text-muted">{item.answer}</p>
      </details>
    ))}
  </div>
</div>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
  summary {
    border-radius: var(--radius-block);
  }
  .faq-toggle {
    position: relative;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    background-color: var(--c-accent-soft);
  }
  .faq-toggle::before,
  .faq-toggle::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 0.875rem;
    height: 2px;
    border-radius: 2px;
    background-color: var(--c-accent);
    transform: translate(-50%, -50%);
    transition: transform 150ms;
  }
  .faq-toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  details[open] .faq-toggle::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  details[open] {
    border-color: var(--c-line-strong);
  }
</style>
