---
/**
 * Lista con el rombo de la marca como viñeta.
 */
interface Props {
  items: readonly string[];
  /** "columns": dos columnas desde tablet. */
  layout?: 'list' | 'columns' | undefined;
  class?: string | undefined;
}

const { items, layout = 'list', class: className } = Astro.props;
---

<ul
  class:list={[
    layout === 'columns' ? 'grid gap-x-8 gap-y-3 sm:grid-cols-2' : 'space-y-3',
    className,
  ]}
>
  {items.map((item) => (
    <li class="flex items-baseline gap-3">
      <span class="rombo translate-y-[-0.1em] text-[0.8em]" aria-hidden="true" />
      <span>{item}</span>
    </li>
  ))}
</ul>
