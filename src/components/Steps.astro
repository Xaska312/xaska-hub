---
/**
 * Pasos en orden (un proceso real, por eso van numerados), cada uno en su tarjeta.
 */
interface Props {
  steps: { title: string; text: string }[];
}

const { steps } = Astro.props;
---

<ol class="grid gap-4 sm:grid-cols-2 lg:grid-flow-col lg:auto-cols-fr lg:grid-cols-none">
  {steps.map((step, index) => (
    <li class="bento flex flex-col gap-6 rounded-block p-6">
      <span class="step-number" aria-hidden="true">
        {String(index + 1).padStart(2, '0')}
      </span>
      <div>
        <h3 class="text-lg">
          <span class="sr-only">{`Paso ${index + 1}: `}</span>
          {step.title}
        </h3>
        <p class="mt-2 text-muted">{step.text}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .step-number {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.875rem;
    background-color: var(--c-accent-soft);
    color: var(--c-accent);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }
</style>
