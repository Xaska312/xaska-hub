---
/**
 * Motivo gráfico "convergencia": cuatro trazos que llegan a un rombo central.
 * Es un recurso decorativo derivado de la geometría del logo; no reemplaza ni redibuja el logo.
 */
interface Props {
  class?: string | undefined;
}
const { class: className } = Astro.props;
---

<svg
  class:list={['convergence', className]}
  viewBox="0 0 400 400"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <g stroke="currentColor" stroke-width="1.25" class="text-line-strong">
    <path class="ray" d="M20 20 L176 176"></path>
    <path class="ray" d="M380 20 L224 176"></path>
    <path class="ray" d="M380 380 L224 224"></path>
    <path class="ray" d="M20 380 L176 224"></path>
  </g>
  <g stroke="currentColor" stroke-width="1" class="text-line">
    <path d="M200 40 V150 M200 250 V360 M40 200 H150 M250 200 H360"></path>
  </g>
  <polygon class="core" points="200,168 232,200 200,232 168,200" fill="var(--c-accent)"></polygon>
</svg>

<style>
  .ray {
    stroke-dasharray: 220;
    stroke-dashoffset: 220;
    animation: draw 900ms cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }
  .ray:nth-child(2) {
    animation-delay: 80ms;
  }
  .ray:nth-child(3) {
    animation-delay: 160ms;
  }
  .ray:nth-child(4) {
    animation-delay: 240ms;
  }
  .core {
    transform-origin: 200px 200px;
    transform: scale(0);
    animation: pop 420ms 760ms cubic-bezier(0.3, 1.4, 0.5, 1) forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes pop {
    to {
      transform: scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ray {
      stroke-dashoffset: 0;
      animation: none;
    }
    .core {
      transform: none;
      animation: none;
    }
  }
</style>
