---
/**
 * Campo de formulario accesible: etiqueta, ayuda y mensaje de error asociados con aria-describedby.
 * El script del formulario llena el mensaje de error (data-error-for) y marca aria-invalid.
 */
interface Props {
  id: string;
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'textarea' | 'select' | undefined;
  required?: boolean | undefined;
  maxlength?: number | undefined;
  autocomplete?: string | undefined;
  hint?: string | undefined;
  options?: readonly string[] | undefined;
  rows?: number | undefined;
  inputmode?: 'text' | 'email' | 'tel' | undefined;
}

const {
  id,
  name,
  label,
  type = 'text',
  required = false,
  maxlength,
  autocomplete,
  hint,
  options = [],
  rows = 6,
  inputmode,
} = Astro.props;

const hintId = hint ? `${id}-ayuda` : undefined;
const errorId = `${id}-error`;
const describedBy = [hintId, errorId].filter(Boolean).join(' ');
const control =
  'mt-2 block w-full rounded-control border border-line-strong bg-bg px-3 py-2.5 text-ink placeholder:text-muted aria-[invalid=true]:border-[var(--c-error)]';
---

<div class="field">
  <label for={id} class="block font-semibold">
    {label}
    {!required && <span class="font-normal text-muted"> (opcional)</span>}
  </label>
  {hint && (
    <p id={hintId} class="mt-1 text-sm text-muted">
      {hint}
    </p>
  )}
  {type === 'textarea' ? (
    <textarea
      id={id}
      name={name}
      rows={rows}
      required={required}
      maxlength={maxlength}
      aria-describedby={describedBy}
      class={control}
    />
  ) : type === 'select' ? (
    <select
      id={id}
      name={name}
      required={required}
      aria-describedby={describedBy}
      class={`${control} min-h-11`}
    >
      <option value="">Elige una opción</option>
      {options.map((option) => (
        <option value={option}>{option}</option>
      ))}
    </select>
  ) : (
    <input
      id={id}
      name={name}
      type={type}
      required={required}
      maxlength={maxlength}
      autocomplete={autocomplete}
      inputmode={inputmode}
      aria-describedby={describedBy}
      class={`${control} min-h-11`}
    />
  )}
  <p id={errorId} class="field-error mt-2 text-sm font-semibold" data-error-for={name}></p>
</div>
