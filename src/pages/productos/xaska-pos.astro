---
import { getEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import ScreenCard from '@/components/ScreenCard.astro';
import Icon from '@/components/Icon.astro';
import sellScreen from '@/assets/pos/header-vender.png';
import type { ImageMetadata } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import PageHeader from '@/components/PageHeader.astro';
import Card from '@/components/Card.astro';
import CTA from '@/components/CTA.astro';
import Faq from '@/components/Faq.astro';
import Steps from '@/components/Steps.astro';
import RomboList from '@/components/RomboList.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import { flags, primaryCta, primaryCtaIsWhatsApp, products, whatsappMessages } from '@/config/site';
import { posApplication } from '@/lib/structured-data';

const posEntry = await getEntry('pos', 'index');
const faqEntry = await getEntry('faq', 'xaska-pos');
if (!posEntry || !faqEntry) throw new Error('Falta el contenido de XASKA POS o sus preguntas');
const pos = posEntry.data;
const faq = faqEntry.data;

// Capturas: cada `image` del contenido es un archivo de src/assets/pos/.
const screenFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/pos/*.png', {
  eager: true,
});
const screens = await Promise.all(
  pos.screens.items.map(async (item) => {
    const file = screenFiles[`/src/assets/pos/${item.image}.png`];
    if (!file) throw new Error(`Falta la captura src/assets/pos/${item.image}.png`);
    // Versión grande en WebP para verla completa al tocar la miniatura.
    const full = await getImage({ src: file.default, format: 'webp' });
    return { ...item, src: file.default, fullSrc: full.src };
  }),
);
const [mainScreen, ...otherScreens] = screens;
const problemIcons = ['book', 'box', 'register', 'chart'] as const;
const [basicPlan] = pos.plans.items;

// Factura electrónica: con la bandera encendida se suma su grupo de funciones y cambia su respuesta.
const capabilityGroups = flags.E_INVOICING
  ? [...pos.capabilities.groups, pos.eInvoicing.group]
  : pos.capabilities.groups;
const faqItems = faq.items.map((item) =>
  flags.E_INVOICING && item.id === 'factura-electronica'
    ? { ...item, answer: pos.eInvoicing.faqAnswer }
    : item,
);
---

<BaseLayout
  title={pos.seo.title}
  description={pos.seo.description}
  whatsappMessage={whatsappMessages.pos}
  jsonLd={[posApplication(pos.seo.description)]}
>
  {/* Como el ingreso a XASKA POS: panel índigo profundo con el lema y "POS" gigante al pie. */}
  <PageHeader
    title={products.pos.name}
    lead={pos.lead}
    slogan={pos.slogan}
    trail={[{ label: 'Productos', href: '/productos' }]}
    tone="deep"
    word="POS"
  >
    <CTA href={primaryCta.href} external>
      {primaryCta.longLabel}
    </CTA>
    {primaryCtaIsWhatsApp ? (
      <CTA href="#planes-seccion" variant="secondary">
        Ver planes
      </CTA>
    ) : (
      <WhatsAppButton message={whatsappMessages.pos} label="Pregúntanos por WhatsApp" />
    )}

    <Fragment slot="visual">
      <ScreenCard
        src={sellScreen}
        alt="Pantalla de ventas de XASKA POS en un minimercado: buscador por código de barras, categorías, productos con precio y existencias, y el total a cobrar."
        fit="zoom"
        sizes="(min-width: 1280px) 760px, (min-width: 1024px) 62vw, 175vw"
        eager
        class="flex-1"
      />
      {basicPlan && (
        <a
          href="#planes-seccion"
          class="bento bento-link flex items-center justify-between gap-4 rounded-block p-5 sm:p-6"
        >
          <span class="flex items-center gap-4">
            <span class="icon-tile">
              <Icon name="register" />
            </span>
            <span>
              <span class="block text-sm text-muted">Planes desde</span>
              <span class="block text-xl font-extrabold">{`${basicPlan.price} al mes`}</span>
            </span>
          </span>
          <Icon name="arrow" class="text-muted" />
        </a>
      )}
    </Fragment>
  </PageHeader>

  <Section labelledby="resuelve">
    <h2 id="resuelve" class="text-3xl sm:text-4xl">
      {pos.problems.title}
    </h2>
    <dl class="mt-8 grid gap-4 md:grid-cols-2">
      {pos.problems.items.map((item, index) => (
        <div class="bento rounded-block p-6 sm:p-8">
          <dt class="flex items-center gap-4 text-lg font-bold">
            <span class="icon-tile">
              <Icon name={problemIcons[index % problemIcons.length] ?? 'check'} />
            </span>
            {item.title}
          </dt>
          <dd class="mt-4 text-muted">{item.text}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section labelledby="para-quien">
    <Card size="panel" class="grid gap-6 lg:grid-cols-[1fr_2fr] lg:gap-16">
      <h2 id="para-quien" class="text-3xl sm:text-4xl">
        {pos.audience.title}
      </h2>
      <p class="max-w-(--container-prose) text-lg">{pos.audience.text}</p>
    </Card>
  </Section>

  {mainScreen && (
    <Section labelledby="asi-se-ve">
      <h2 id="asi-se-ve" class="text-3xl sm:text-4xl">
        {pos.screens.title}
      </h2>
      <p class="mt-4 max-w-(--container-prose) text-lg text-muted">{pos.screens.lead}</p>
      <ScreenCard
        src={mainScreen.src}
        alt={mainScreen.alt}
        sizes="(min-width: 1280px) 1216px, calc(100vw - 2rem)"
        class="mt-8"
      >
        {mainScreen.caption}
      </ScreenCard>
      {otherScreens.length > 0 && (
        <ul class="mt-4 grid gap-4 sm:grid-cols-2">
          {otherScreens.map((screen) => (
            <li>
              <figure class="bento h-full rounded-panel p-2 sm:p-3">
                <a
                  href={screen.fullSrc}
                  target="_blank"
                  rel="noopener"
                  class="flex aspect-[4/3] items-center justify-center overflow-hidden rounded-block border border-line bg-inset p-4 transition-colors hover:border-accent"
                >
                  <Image
                    src={screen.src}
                    alt={screen.alt}
                    widths={[480, 720, 1080]}
                    sizes="(min-width: 1280px) 580px, (min-width: 640px) 45vw, calc(100vw - 2rem)"
                    class="max-h-full w-auto max-w-full rounded-control object-contain"
                    loading="lazy"
                  />
                  <span class="sr-only"> (ver la imagen completa en una pestaña nueva)</span>
                </a>
                <figcaption class="px-3 pt-3 pb-2 text-sm text-muted">{screen.caption}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      )}
    </Section>
  )}

  <Section labelledby="funciones">
    <h2 id="funciones" class="text-3xl sm:text-4xl">
      {pos.capabilities.title}
    </h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {capabilityGroups.map((group) => (
        <div class="bento rounded-block p-6 sm:p-8">
          <h3 class="text-lg">{group.title}</h3>
          <RomboList items={group.items} class="mt-5 text-muted" />
        </div>
      ))}
    </div>
    <p class="mt-6">
      <a class="link font-semibold" href={products.pos.manualUrl} target="_blank" rel="noopener">
        Ver el manual de uso de XASKA POS
        <span class="sr-only"> (se abre en una pestaña nueva)</span>
      </a>
    </p>
  </Section>

  <Section labelledby="empezar">
    <h2 id="empezar" class="text-3xl sm:text-4xl">
      {pos.start.title}
    </h2>
    <div class="mt-8">
      <Steps steps={pos.start.steps} />
    </div>
  </Section>

  <Section id="planes-seccion" labelledby="planes" class="scroll-mt-20">
    <h2 id="planes" class="text-3xl sm:text-4xl">
      {pos.plans.title}
    </h2>
    <p class="mt-4 max-w-(--container-prose) text-lg text-muted">{pos.plans.lead}</p>
    <ul class="mt-8 grid gap-4 lg:grid-cols-3">
      {pos.plans.items.map((plan, index) => (
        <Card as="li" tone={index === 1 ? 'deep' : 'default'} size="panel" class="flex flex-col">
          <h3 class="text-xl">{plan.name}</h3>
          <p class="mt-3">
            <span class="text-4xl font-extrabold tracking-tight">{plan.price}</span>
            <span class="ml-1 font-semibold text-muted">al mes</span>
          </p>
          <p class="mt-1 text-muted">{`o ${plan.annual}`}</p>
          <p class="mt-6 rounded-control bg-inset px-4 py-3 font-semibold">{plan.limits}</p>
          <ul class="mt-6 space-y-3">
            {plan.features.map((feature) => (
              <li class="flex items-start gap-3">
                <Icon name="check" size={20} class="mt-0.5 shrink-0 text-accent" />
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </Card>
      ))}
    </ul>

    <div class="bento mt-4 rounded-panel p-2 sm:p-4">
      <h3 class="px-4 pt-4 text-lg">{pos.plans.comparison.title}</h3>
      <div class="mt-2 overflow-x-auto" tabindex="0" aria-label={pos.plans.comparison.title}>
        <table class="w-full min-w-[40rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-line">
              <td class="p-4"></td>
              {pos.plans.items.map((plan) => (
                <th scope="col" class="p-4 font-bold">
                  {plan.name}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {pos.plans.comparison.rows.map((row) => (
              <tr class="border-b border-line last:border-b-0">
                <th scope="row" class="max-w-[22rem] p-4 font-normal text-muted">
                  {row.label}
                </th>
                {row.values.map((value) => (
                  <td class="p-4 font-semibold">
                    {value === 'sí' ? (
                      <>
                        <Icon name="check" size={20} class="text-accent" />
                        <span class="sr-only">Incluido</span>
                      </>
                    ) : value === 'no' ? (
                      <>
                        <span aria-hidden="true" class="text-muted">
                          —
                        </span>
                        <span class="sr-only">No incluido</span>
                      </>
                    ) : (
                      value
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <p class="mt-4 text-muted">{pos.plans.note}</p>
    <div class="mt-6 grid gap-4 lg:grid-cols-[1fr_auto]">
      <Card class="flex items-start gap-5">
        <span class="icon-tile">
          <Icon name="monitor" />
        </span>
        <p class="text-lg">
          {pos.plans.equipment.text}{' '}
          <a class="link font-semibold" href="/servicios#equipos-y-computadores">
            {pos.plans.equipment.linkLabel}
          </a>
        </p>
      </Card>
      <Card tone="feature" class="flex items-center justify-center">
        <CTA href={primaryCta.href} external>
          {primaryCta.longLabel}
        </CTA>
      </Card>
    </div>
  </Section>

  <Section labelledby="preguntas">
    <Faq title={faq.title} items={faqItems} headingId="preguntas" />
    <div class="mt-6 flex flex-wrap items-center gap-4">
      <p class="text-muted">¿Tienes otra pregunta?</p>
      <WhatsAppButton message={whatsappMessages.pos} label="Escríbenos" />
    </div>
  </Section>
</BaseLayout>
