---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Faq from '@/components/Faq.astro';
import { faqPage, localBusiness } from '@/lib/structured-data';
import Section from '@/components/Section.astro';
import CTA from '@/components/CTA.astro';
import Card from '@/components/Card.astro';
import Icon from '@/components/Icon.astro';
import SegmentGlyph from '@/components/SegmentGlyph.astro';
import Steps from '@/components/Steps.astro';
import RomboList from '@/components/RomboList.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import AskaBand from '@/components/AskaBand.astro';
import LiveRegister from '@/components/LiveRegister.astro';
import ChapterTabs from '@/components/ChapterTabs.astro';
import { serviceIcon } from '@/lib/service-icons';
import {
  contact,
  primaryCta,
  primaryCtaIsWhatsApp,
  products,
  whatsappMessages,
  whatsappUrl,
} from '@/config/site';

const entry = await getEntry('home', 'index');
const faqEntry = await getEntry('faq', 'inicio');
const posEntry = await getEntry('pos', 'index');
if (!entry || !posEntry || !faqEntry) {
  throw new Error('Falta src/content/home/index.yaml, el de XASKA POS o las preguntas de inicio');
}
const faq = faqEntry.data;
const home = entry.data;
const slogan = posEntry.data.slogan.join(' ');
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const landings = (await getCollection('landings')).sort((a, b) => a.data.order - b.data.order);
const [productPillar, projectsPillar, directPillar] = home.pillars.items;
---

<BaseLayout
  title={home.seo.title}
  description={home.seo.description}
  whatsappMessage={whatsappMessages.general}
  jsonLd={[localBusiness(), faqPage(faq.items)]}
>
  {/* Entrada: la caja de XASKA POS funcionando. A la izquierda el título, a la derecha la caja. */}
  <section class="pt-6 pb-4 sm:pt-10" aria-labelledby="portada">
    <div class="mx-auto grid w-full max-w-(--container-page) items-center gap-10 px-4 sm:px-6 lg:grid-cols-12 lg:gap-12 lg:px-8">
      <div class="flex flex-col gap-6 lg:col-span-5">
        <div class="flex flex-wrap gap-2">
          <span class="chip">{home.hero.badge}</span>
          <span class="chip">Hecho en Ibagué</span>
        </div>
        <h1
          id="portada"
          class="text-[2.6rem] leading-[1.03] sm:text-5xl lg:text-[3.4rem] lg:leading-[1.02]"
        >
          {home.hero.title}
        </h1>
        <p class="max-w-[42ch] text-lg font-medium text-muted">{home.hero.lead}</p>
        <div class="flex flex-wrap items-center gap-3">
          <CTA href={primaryCta.href} external>
            {primaryCta.longLabel}
          </CTA>
          {primaryCtaIsWhatsApp ? (
            <CTA href={products.pos.path} variant="secondary">
              Conocer XASKA POS
            </CTA>
          ) : (
            <WhatsAppButton message={whatsappMessages.general} />
          )}
        </div>
        <p class="font-bold text-accent">{slogan}</p>
      </div>
      <div class="min-w-0 lg:col-span-7">
        <LiveRegister products={home.register.products} caption={home.register.caption} />
      </div>
    </div>
  </section>

  <Section labelledby="capitulos">
    <h2 id="capitulos" class="text-3xl sm:text-4xl">
      {home.chapters.title}
    </h2>
    <div class="mt-8">
      <ChapterTabs
        chapters={home.chapters.items}
        note={home.chapters.note}
        label="Lo que hace XASKA POS"
      />
    </div>
  </Section>

  <Section labelledby="xaska-pos">
    <div class="grid gap-4 lg:grid-cols-12">
      <Card
        tone="deep"
        size="panel"
        class="relative flex flex-col justify-between gap-10 overflow-hidden lg:col-span-5"
      >
        <div>
          <span class="chip">POS</span>
          <h2 id="xaska-pos" class="mt-6 text-3xl sm:text-4xl">
            {home.pos.title}
          </h2>
          <p class="mt-4 text-lg text-muted">{home.pos.lead}</p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <CTA href={primaryCta.href} external>
              {primaryCta.longLabel}
            </CTA>
            <CTA href={products.pos.path} variant="secondary">
              Ver lo que hace
            </CTA>
          </div>
        </div>
        {/* Como el panel de ingreso al POS: "POS" en letra gigante, cortado por el borde. */}
        <p
          aria-hidden="true"
          class="giant-word -mx-2 -mb-6 h-[0.62em] overflow-hidden text-[8rem] sm:-mb-10 sm:text-[12rem]"
        >
          POS
        </p>
      </Card>
      <Card class="lg:col-span-7">
        <h3 class="text-lg">Lo que trae</h3>
        <RomboList items={home.pos.highlights} layout="columns" class="mt-5" />
        <h3 class="mt-8 text-lg">Hecho para tu negocio</h3>
        <ul class="mt-4 flex flex-wrap gap-2" aria-label="XASKA POS por tipo de negocio">
          {landings.map((item) => (
            <li class={`seg-${item.id}`}>
              <a
                href={`/para/${item.id}`}
                class="press inline-flex min-h-11 items-center gap-2 rounded-full bg-(--seg-soft) px-4 font-semibold text-(--seg-strong)"
              >
                <SegmentGlyph segment={item.id} size={18} />
                {item.data.name}
              </a>
            </li>
          ))}
        </ul>
      </Card>
    </div>
  </Section>

  <Section labelledby="aska-portada">
    <AskaBand headingId="aska-portada" />
  </Section>

  {/* Quiénes somos: producto propio, proyectos a la medida y trato directo. */}
  <Section labelledby="lo-que-hacemos">
    <div class="grid gap-4 lg:grid-cols-12">
      <div class="flex flex-col justify-end gap-4 py-2 lg:col-span-4">
        <h2 id="lo-que-hacemos" class="text-3xl">
          {home.pillars.title}
        </h2>
        <p class="text-lg text-muted">{home.pillars.lead}</p>
      </div>
      {productPillar && (
        <a
          href={productPillar.link?.href ?? products.pos.path}
          class="bento bento-link flex flex-col justify-between gap-8 rounded-panel p-6 sm:p-8 lg:col-span-4"
        >
          <span class="flex items-center justify-between gap-4">
            <span class="chip">{productPillar.title}</span>
            <Icon name="arrow" class="text-muted" />
          </span>
          <span>
            <span class="block text-3xl font-extrabold tracking-tight">{products.pos.name}</span>
            <span class="mt-3 block text-muted">{productPillar.text}</span>
          </span>
        </a>
      )}
      <div class="grid gap-4 sm:grid-cols-2 lg:col-span-4 lg:grid-cols-1">
        {projectsPillar && (
          <a
            href={projectsPillar.link?.href ?? '/servicios'}
            class="bento bento-link flex flex-col gap-4 rounded-block p-6"
          >
            <span class="icon-tile">
              <Icon name="code" />
            </span>
            <span>
              <span class="block text-xl font-bold">{projectsPillar.title}</span>
              <span class="mt-2 block text-sm text-muted">{projectsPillar.text}</span>
            </span>
          </a>
        )}
        {directPillar && (
          <a
            href={whatsappUrl(whatsappMessages.general)}
            target="_blank"
            rel="noopener"
            class="on-deep bento-link flex flex-col gap-4 rounded-block p-6"
          >
            <span class="icon-tile">
              <Icon name="chat" />
            </span>
            <span>
              <span class="block text-xl font-bold">{directPillar.title}</span>
              <span class="mt-2 block text-sm text-muted">{directPillar.text}</span>
              <span class="sr-only">(se abre WhatsApp en una pestaña nueva)</span>
            </span>
          </a>
        )}
      </div>
    </div>
  </Section>

  <Section labelledby="servicios">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <li class="bento flex flex-col justify-between gap-8 rounded-block p-6 sm:p-8">
        <div>
          <h2 id="servicios" class="text-3xl">
            {home.services.title}
          </h2>
          <p class="mt-4 text-muted">{home.services.lead}</p>
        </div>
        <a class="link font-semibold" href="/servicios">
          Ver todos los servicios
        </a>
      </li>
      {services.map((service) => (
        <li class={`flex seg-${service.id}`}>
          <a
            href={`/servicios/${service.id}`}
            class="bento bento-link flex w-full flex-col justify-between gap-10 rounded-block p-6 sm:p-8"
          >
            <span class="flex items-start justify-between gap-4">
              <span class="seg-tile">
                <Icon name={serviceIcon(service.id)} />
              </span>
              <Icon name="arrow" class="text-muted" />
            </span>
            <div>
              <h3 class="text-xl">{service.data.title}</h3>
              <p class="mt-2 text-muted">{service.data.summary}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Section labelledby="por-que">
    <div class="grid gap-4 lg:grid-cols-3">
      <Card tone="feature" class="flex items-end">
        <h2 id="por-que" class="text-3xl sm:text-4xl">
          {home.why.title}
        </h2>
      </Card>
      {home.why.items.map((item, index) => (
        <Card>
          <span class="icon-tile">
            <Icon name={index === 0 ? 'users' : 'store'} />
          </span>
          <h3 class="mt-8 text-xl">{item.title}</h3>
          <p class="mt-3 text-muted">{item.text}</p>
        </Card>
      ))}
    </div>
  </Section>

  <Section labelledby="como-trabajamos">
    <h2 id="como-trabajamos" class="text-3xl sm:text-4xl">
      {home.process.title}
    </h2>
    <div class="mt-8">
      <Steps steps={home.process.steps} />
    </div>
  </Section>

  <Section labelledby="preguntas-inicio">
    <Faq title={faq.title} items={faq.items} headingId="preguntas-inicio" />
  </Section>

  <Section labelledby="cierre">
    <Card tone="deep" size="panel" class="grid items-center gap-8 lg:grid-cols-[1fr_auto] lg:p-14">
      <div>
        <h2 id="cierre" class="text-3xl sm:text-5xl">
          {home.closing.title}
        </h2>
        <p class="mt-4 max-w-(--container-prose) text-lg text-muted">{home.closing.text}</p>
      </div>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
        <WhatsAppButton message={whatsappMessages.services} variant="solid" />
        <a class="link font-semibold" href={`mailto:${contact.email}`}>
          {contact.email}
        </a>
      </div>
    </Card>
  </Section>
</BaseLayout>
