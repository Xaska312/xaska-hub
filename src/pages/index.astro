---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import CTA from '@/components/CTA.astro';
import Card from '@/components/Card.astro';
import Icon from '@/components/Icon.astro';
import Steps from '@/components/Steps.astro';
import RomboList from '@/components/RomboList.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import PageHeader from '@/components/PageHeader.astro';
import ScreenCard from '@/components/ScreenCard.astro';
import reportsScreen from '@/assets/pos/header-reportes.png';
import { serviceIcon } from '@/lib/service-icons';
import {
  contact,
  primaryCta,
  primaryCtaIsWhatsApp,
  products,
  whatsappMessages,
  whatsappUrl,
} from '@/config/site';

const entry = await getEntry('home', 'index');
const posEntry = await getEntry('pos', 'index');
if (!entry || !posEntry) throw new Error('Falta src/content/home/index.yaml o el de XASKA POS');
const home = entry.data;
const slogan = posEntry.data.slogan.join(' ');
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const [productPillar, projectsPillar, directPillar] = home.pillars.items;
---

<BaseLayout
  title={home.seo.title}
  description={home.seo.description}
  whatsappMessage={whatsappMessages.general}
>
  {/* Entrada bento, como el inicio de XASKA POS: la tarjeta destacada con el título y, al lado,
      lo que hacemos (producto propio, proyectos a la medida y trato directo). */}
  <PageHeader title={home.hero.title} lead={home.hero.lead} badge="Hecho en Ibagué">
    <CTA href={primaryCta.href} external>
      {primaryCta.longLabel}
    </CTA>
    {primaryCtaIsWhatsApp ? (
      <CTA href={products.pos.path} variant="secondary">
        Conocer XASKA POS
      </CTA>
    ) : (
      <WhatsAppButton message={whatsappMessages.general} />
    )}

    <Fragment slot="visual">
      <h2 class="sr-only">{home.pillars.title}</h2>
      {productPillar && (
        <a
          href={productPillar.link?.href ?? products.pos.path}
          class="bento bento-link flex flex-1 flex-col justify-between gap-8 rounded-panel p-6 sm:p-8"
        >
          <span class="flex items-center justify-between gap-4">
            <span class="chip">{productPillar.title}</span>
            <Icon name="arrow" class="text-muted" />
          </span>
          <span>
            <span class="block text-3xl font-extrabold tracking-tight">{products.pos.name}</span>
            <span class="mt-1 block font-bold text-accent">{slogan}</span>
            <span class="mt-3 block text-muted">{productPillar.text}</span>
          </span>
        </a>
      )}
      <div class="grid gap-4 sm:grid-cols-2">
        {projectsPillar && (
          <a
            href={projectsPillar.link?.href ?? '/servicios'}
            class="bento bento-link flex flex-col justify-between gap-8 rounded-block p-6"
          >
            <span class="icon-tile">
              <Icon name="code" />
            </span>
            <span>
              <span class="block text-xl font-bold">{projectsPillar.title}</span>
              <span class="mt-2 block text-sm text-muted">{projectsPillar.text}</span>
            </span>
          </a>
        )}
        {directPillar && (
          <a
            href={whatsappUrl(whatsappMessages.general)}
            target="_blank"
            rel="noopener"
            class="on-deep bento-link flex flex-col justify-between gap-8 rounded-block p-6"
          >
            <span class="icon-tile">
              <Icon name="chat" />
            </span>
            <span>
              <span class="block text-xl font-bold">{directPillar.title}</span>
              <span class="mt-2 block text-sm text-muted">{directPillar.text}</span>
              <span class="sr-only">(se abre WhatsApp en una pestaña nueva)</span>
            </span>
          </a>
        )}
      </div>
    </Fragment>
  </PageHeader>

  <Section labelledby="xaska-pos">
    <div class="grid gap-4 lg:grid-cols-12">
      <Card
        tone="deep"
        size="panel"
        class="relative flex flex-col justify-between gap-10 overflow-hidden lg:col-span-5"
      >
        <div>
          <span class="chip">POS</span>
          <h2 id="xaska-pos" class="mt-6 text-3xl sm:text-4xl">
            {home.pos.title}
          </h2>
          <p class="mt-4 text-lg text-muted">{home.pos.lead}</p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <CTA href={primaryCta.href} external>
              {primaryCta.longLabel}
            </CTA>
            <CTA href={products.pos.path} variant="secondary">
              Ver lo que hace
            </CTA>
          </div>
        </div>
        {/* Como el panel de ingreso al POS: "POS" en letra gigante, cortado por el borde. */}
        <p
          aria-hidden="true"
          class="giant-word -mx-2 -mb-6 h-[0.62em] overflow-hidden text-[8rem] sm:-mb-10 sm:text-[12rem]"
        >
          POS
        </p>
      </Card>
      <div class="flex min-w-0 flex-col gap-4 lg:col-span-7">
        <ScreenCard
          src={reportsScreen}
          alt="Inicio de XASKA POS con las ventas del día, la utilidad, las ventas por hora, los medios de pago y los productos más vendidos."
          sizes="(min-width: 1280px) 730px, (min-width: 1024px) 58vw, calc(100vw - 2rem)"
        >
          El inicio de XASKA POS: ventas del día, medios de pago y lo que más se vende.
        </ScreenCard>
        <Card class="flex-1">
          <h3 class="text-lg">Lo que trae</h3>
          <RomboList items={home.pos.highlights} layout="columns" class="mt-5" />
        </Card>
      </div>
    </div>
  </Section>

  <Section labelledby="servicios">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <li class="bento flex flex-col justify-between gap-8 rounded-block p-6 sm:p-8">
        <div>
          <h2 id="servicios" class="text-3xl">
            {home.services.title}
          </h2>
          <p class="mt-4 text-muted">{home.services.lead}</p>
        </div>
        <a class="link font-semibold" href="/servicios">
          Ver todos los servicios
        </a>
      </li>
      {services.map((service) => (
        <li class="flex">
          <a
            href={`/servicios#${service.id}`}
            class="bento bento-link flex w-full flex-col justify-between gap-10 rounded-block p-6 sm:p-8"
          >
            <span class="flex items-start justify-between gap-4">
              <span class="icon-tile">
                <Icon name={serviceIcon(service.id)} />
              </span>
              <Icon name="arrow" class="text-muted" />
            </span>
            <div>
              <h3 class="text-xl">{service.data.title}</h3>
              <p class="mt-2 text-muted">{service.data.summary}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Section labelledby="por-que">
    <div class="grid gap-4 lg:grid-cols-3">
      <Card tone="feature" class="flex items-end">
        <h2 id="por-que" class="text-3xl sm:text-4xl">
          {home.why.title}
        </h2>
      </Card>
      {home.why.items.map((item, index) => (
        <Card>
          <span class="icon-tile">
            <Icon name={index === 0 ? 'users' : 'store'} />
          </span>
          <h3 class="mt-8 text-xl">{item.title}</h3>
          <p class="mt-3 text-muted">{item.text}</p>
        </Card>
      ))}
    </div>
  </Section>

  <Section labelledby="como-trabajamos">
    <h2 id="como-trabajamos" class="text-3xl sm:text-4xl">
      {home.process.title}
    </h2>
    <div class="mt-8">
      <Steps steps={home.process.steps} />
    </div>
  </Section>

  <Section labelledby="cierre">
    <Card tone="deep" size="panel" class="grid items-center gap-8 lg:grid-cols-[1fr_auto] lg:p-14">
      <div>
        <h2 id="cierre" class="text-3xl sm:text-5xl">
          {home.closing.title}
        </h2>
        <p class="mt-4 max-w-(--container-prose) text-lg text-muted">{home.closing.text}</p>
      </div>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
        <WhatsAppButton message={whatsappMessages.services} variant="solid" />
        <a class="link font-semibold" href={`mailto:${contact.email}`}>
          {contact.email}
        </a>
      </div>
    </Card>
  </Section>
</BaseLayout>
