---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import { whatsappMessages } from '@/config/site';
import { isProductionBuild } from '@/lib/pendientes';

export const getStaticPaths = (async () => {
  const docs = await getCollection('legal');
  return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc } }));
}) satisfies GetStaticPaths;

const { doc } = Astro.props;
const { Content } = await render(doc);

if (isProductionBuild() && !doc.data.reviewed) {
  throw new Error(`Falta la revisión legal de "${doc.data.title}" (campo reviewed).`);
}

const updated = new Intl.DateTimeFormat('es-CO', {
  dateStyle: 'long',
  timeZone: 'America/Bogota',
}).format(new Date(`${doc.data.updated}T12:00:00-05:00`));
---

<BaseLayout
  title={doc.data.title}
  description={doc.data.description}
  whatsappMessage={whatsappMessages.general}
>
  <Section class="pt-4 sm:pt-8">
    <div class="on-feature rounded-panel p-6 sm:p-10">
      {!doc.data.reviewed && (
        <p class="mb-8 rounded-control border border-line-strong px-4 py-3 font-semibold">
          Borrador pendiente de revisión legal
        </p>
      )}
      <span class="chip">Legal</span>
      <h1 class="mt-6 max-w-[20ch] text-4xl sm:text-5xl">{doc.data.title}</h1>
      <p class="mt-4 font-medium">{`Última actualización: ${updated}`}</p>
    </div>
    <div class="bento mt-4 rounded-panel p-6 sm:p-10">
      <div class="prose-xaska legal max-w-(--container-prose)">
        <Content />
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .legal :global(h2) {
    margin-top: 2.5rem;
    font-size: var(--text-xl);
    line-height: var(--text-xl--line-height);
  }
  .legal :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .legal :global(li + li) {
    margin-top: 0.4rem;
  }
  .legal :global(strong) {
    font-weight: 600;
  }
</style>
