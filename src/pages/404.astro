---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import CTA from '@/components/CTA.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import { whatsappMessages } from '@/config/site';
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe o cambió de dirección."
  whatsappMessage={whatsappMessages.notFound}
  noindex
>
  <PageHeader
    title="No encontramos esta página"
    lead="Puede que el enlace esté mal escrito o que la página haya cambiado de dirección. Vuelve al inicio o cuéntanos qué buscabas."
    badge="Error 404"
    word="404"
  >
    <CTA href="/">Volver al inicio</CTA>
    <WhatsAppButton message={whatsappMessages.notFound} />
  </PageHeader>
</BaseLayout>
