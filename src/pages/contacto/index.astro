---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import PageHeader from '@/components/PageHeader.astro';
import ContactForm from '@/components/ContactForm.astro';
import CTA from '@/components/CTA.astro';
import Card from '@/components/Card.astro';
import Icon from '@/components/Icon.astro';
import { contact, site, whatsappMessages, whatsappUrl } from '@/config/site';
import { TURNSTILE_ORIGIN } from '@/lib/turnstile';

// Turnstile: script y marco desde challenges.cloudflare.com, solo en esta página.
if (!Astro.csp) throw new Error('La CSP debe estar activa (security.csp en astro.config.mjs).');
// Al agregar un origen, Astro reemplaza las fuentes por defecto: hay que volver a incluir 'self'.
Astro.csp.insertScriptResource("'self'");
Astro.csp.insertScriptResource(TURNSTILE_ORIGIN);
Astro.csp.insertDirective(`frame-src ${TURNSTILE_ORIGIN}`);
---

<BaseLayout
  title="Contacto"
  description="Escríbele a XASKA por el formulario, por WhatsApp o por correo. Estamos en Ibagué, Tolima, y trabajamos con pymes de toda Colombia."
  whatsappMessage={whatsappMessages.general}
>
  <PageHeader
    title="Contacto"
    lead="Escríbenos por el canal que prefieras. Te responde directamente el equipo de XASKA."
    tone="deep"
    word="Hola"
  >
    <aside slot="visual" aria-labelledby="otros-canales" class="flex-1">
      <h2 id="otros-canales" class="sr-only">
        Canales directos
      </h2>
      <dl class="grid h-full gap-4">
        <div class="bento flex flex-col justify-between gap-6 rounded-panel p-6 sm:p-8">
          <dt class="flex items-center gap-4 font-semibold text-muted">
            <span class="icon-tile">
              <Icon name="chat" />
            </span>
            WhatsApp, la forma más rápida
          </dt>
          <dd class="flex flex-wrap items-center justify-between gap-4">
            <span class="text-2xl font-extrabold whitespace-nowrap sm:text-3xl">
              {contact.whatsapp.display}
            </span>
            <CTA href={whatsappUrl(whatsappMessages.general)} external>
              Abrir WhatsApp
            </CTA>
          </dd>
        </div>
        <div class="bento rounded-block p-6">
          <dt class="flex items-center gap-4 font-semibold text-muted">
            <span class="icon-tile">
              <Icon name="mail" />
            </span>
            Correo, para propuestas y documentos
          </dt>
          <dd class="mt-4">
            <a class="link text-xl font-bold break-all" href={`mailto:${contact.email}`}>
              {contact.email}
            </a>
          </dd>
        </div>
        <div class="bento flex items-start gap-4 rounded-block p-6 text-muted">
          <dt class="icon-tile">
            <Icon name="pin" />
            <span class="sr-only">Ubicación y horario</span>
          </dt>
          <dd>
            <p class="font-semibold text-ink">{`Estamos en ${site.city}.`}</p>
            {contact.hours && (
              <p class="mt-1">{`Horario de atención: ${contact.hours.charAt(0).toLowerCase()}${contact.hours.slice(1)}`}</p>
            )}
          </dd>
        </div>
      </dl>
    </aside>
  </PageHeader>

  <Section labelledby="formulario">
    <div class="grid gap-4 lg:grid-cols-12">
      <Card size="panel" class="lg:col-span-8">
        <h2 id="formulario" class="text-3xl sm:text-4xl">
          Déjanos un mensaje
        </h2>
        <p class="mt-4 text-lg text-muted">
          Cuéntanos qué necesitas y te respondemos al correo que escribas.
        </p>
        <div class="mt-8">
          <ContactForm />
        </div>
      </Card>
      <Card
        tone="feature"
        size="panel"
        class="flex flex-col justify-between gap-10 self-start lg:col-span-4"
      >
        <span class="icon-tile">
          <Icon name="chat" />
        </span>
        <div>
          <h3 class="text-2xl">¿Prefieres hablar ya?</h3>
          <p class="mt-3 font-medium">Por WhatsApp te respondemos más rápido, de lunes a sábado.</p>
          <div class="mt-6">
            <CTA href={whatsappUrl(whatsappMessages.general)} external>
              Abrir WhatsApp
            </CTA>
          </div>
        </div>
      </Card>
    </div>
  </Section>
</BaseLayout>
