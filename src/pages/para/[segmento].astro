---
/**
 * Sección por tipo de negocio: /para/restaurantes, /para/tiendas, /para/servicios,
 * /para/droguerias y /para/distribuidores. Contenido en src/content/landings/<segmento>.yaml;
 * colores en src/styles/segments.css; ilustración interactiva en src/components/scenes/.
 *
 * Hecha para anuncios y visitas: un solo objetivo, escribir por WhatsApp. El mensaje prellenado
 * es distinto en cada sección, así Daniel sabe de cuál llegó cada conversación (sin rastreo).
 * "Probar gratis" queda como segunda opción, más discreta.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import Icon from '@/components/Icon.astro';
import Steps from '@/components/Steps.astro';
import Faq from '@/components/Faq.astro';
import CTA from '@/components/CTA.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import SegmentGlyph from '@/components/SegmentGlyph.astro';
import RestaurantScene from '@/components/scenes/RestaurantScene.astro';
import StoreScene from '@/components/scenes/StoreScene.astro';
import ServicesScene from '@/components/scenes/ServicesScene.astro';
import PharmacyScene from '@/components/scenes/PharmacyScene.astro';
import RouteScene from '@/components/scenes/RouteScene.astro';
import { contact, products, primaryCta } from '@/config/site';
import { faqPage } from '@/lib/structured-data';

export const getStaticPaths = (async () => {
  const landings = await getCollection('landings');
  return landings.map((entry) => ({ params: { segmento: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const scenes = {
  restaurantes: RestaurantScene,
  tiendas: StoreScene,
  servicios: ServicesScene,
  droguerias: PharmacyScene,
  distribuidores: RouteScene,
} as const;

const { entry } = Astro.props;
const page = entry.data;
const segment = entry.id as keyof typeof scenes;
const Scene = scenes[segment];
if (!Scene) throw new Error(`Falta la ilustración de /para/${entry.id} en src/components/scenes/`);

const pos = (await getEntry('pos', 'index'))?.data;
if (!pos) throw new Error('Falta src/content/pos/index.yaml');
const plan = pos.plans.items.find((item) => item.name === page.pricing.plan);
if (!plan) throw new Error(`El plan ${page.pricing.plan} no está en los planes de XASKA POS`);
const others = (await getCollection('landings'))
  .filter((item) => item.id !== entry.id)
  .sort((a, b) => a.data.order - b.data.order);

const steps = [
  {
    title: 'Escríbenos',
    text: 'Por WhatsApp, con lo que vendes y cómo trabajas hoy. Nuestro asistente te responde al instante y, si hace falta, te pasa con Daniel.',
  },
  {
    title: 'Míralo con lo tuyo',
    text: 'En 10 minutos te mostramos XASKA POS con productos y trabajos como los tuyos, sin compromiso.',
  },
  {
    title: 'Pruébalo 14 días gratis',
    text: 'Sin tarjeta. Si te sirve, eliges tu plan; si no, no pagas nada.',
  },
];
const wide = page.hero.layout === 'wide';
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  whatsappMessage={page.whatsapp}
  jsonLd={[faqPage(page.faq)]}
>
  <div class:list={['seg-page pb-8', `seg-${segment}`]}>
    <section class="pt-6 pb-4 sm:pt-10" aria-labelledby="landing">
      <div
        class:list={[
          'mx-auto grid w-full max-w-(--container-page) gap-10 px-4 sm:px-6 lg:gap-12 lg:px-8',
          !wide && 'items-center lg:grid-cols-12',
        ]}
      >
        <div
          class:list={[
            'flex min-w-0 flex-col gap-6',
            wide ? 'lg:flex-row lg:items-end lg:justify-between' : 'lg:col-span-5',
          ]}
        >
          <div class="flex min-w-0 flex-col gap-6">
            <span class="seg-chip self-start">
              <SegmentGlyph segment={segment} size={18} />
              {page.chip}
            </span>
            <h1
              id="landing"
              class:list={[
                'text-[2.4rem] leading-[1.04] sm:text-5xl lg:text-[3.2rem] lg:leading-[1.03]',
                wide && 'max-w-[18ch]',
              ]}
            >
              {page.hero.title}
            </h1>
            <p class="max-w-[48ch] text-lg font-medium text-muted">{page.hero.lead}</p>
          </div>
          <div class="flex flex-col gap-3">
            <div class="flex flex-wrap items-center gap-3">
              <WhatsAppButton message={page.whatsapp} label={page.hero.cta} variant="segment" />
              <CTA href={primaryCta.href} variant="secondary" external>
                Probar gratis 14 días
              </CTA>
            </div>
            <p class="max-w-[44ch] text-sm text-muted">{contact.assistant}</p>
          </div>
        </div>
        <div class:list={['min-w-0', !wide && 'lg:col-span-7']}>
          <Scene />
        </div>
      </div>
    </section>

    <Section labelledby="momentos">
      <h2 id="momentos" class="text-3xl sm:text-4xl">
        {page.moments.title}
      </h2>
      <ol class="mt-8 grid gap-4 md:grid-cols-3">
        {page.moments.items.map((item) => (
          <li class="seg-moment flex flex-col gap-2 p-6 sm:p-7">
            <span class="seg-moment-time text-sm font-extrabold text-(--seg-strong)">
              {item.time}
            </span>
            <h3 class="text-xl">{item.title}</h3>
            <p class="seg-moment-text text-muted">{item.text}</p>
          </li>
        ))}
      </ol>
    </Section>

    <Section labelledby="empieza">
      <h2 id="empieza" class="text-3xl sm:text-4xl">
        Así empiezas
      </h2>
      <div class="mt-8">
        <Steps steps={steps} />
      </div>
    </Section>

    <Section labelledby="precio">
      <div class="grid gap-4 lg:grid-cols-12">
        <div class="seg-panel flex flex-col justify-between gap-8 rounded-panel p-7 sm:p-10 lg:col-span-7">
          <div>
            <span class="inline-flex rounded-full bg-white/15 px-3.5 py-2 text-sm font-bold">
              Plan {plan.name}
            </span>
            <h2 id="precio" class="mt-6 text-3xl sm:text-4xl">
              {plan.price} <span class="seg-panel-muted text-xl font-semibold">al mes</span>
            </h2>
            <p class="seg-panel-muted mt-3 text-lg">
              {plan.limits}. {page.pricing.note}
            </p>
            <p class="seg-panel-muted mt-2">O {plan.annual}: pagas 10 meses.</p>
          </div>
          <div class="flex flex-wrap items-center gap-4">
            <WhatsAppButton message={page.whatsapp} label={page.hero.cta} variant="segment" />
            <a
              class="font-semibold text-white underline underline-offset-4"
              href={`${products.pos.path}#planes-seccion`}
            >
              Ver todos los planes
            </a>
          </div>
        </div>
        <div class="bento flex flex-col gap-4 rounded-panel p-7 lg:col-span-5">
          <h3 class="text-lg">Incluye</h3>
          <ul class="flex flex-col gap-3">
            {plan.features.map((feature) => (
              <li class="flex gap-3">
                <span class="text-(--seg-strong)">
                  <Icon name="check" size={20} />
                </span>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
          <p class="mt-auto text-sm text-muted">14 días de prueba gratis, sin tarjeta.</p>
        </div>
      </div>
    </Section>

    <Section labelledby="preguntas-landing">
      <Faq title="Preguntas frecuentes" items={page.faq} headingId="preguntas-landing" />
    </Section>

    <Section labelledby="otros">
      <h2 id="otros" class="text-2xl">
        ¿Tienes otro tipo de negocio?
      </h2>
      <ul class="mt-6 flex flex-wrap gap-2">
        {others.map((item) => (
          <li class={`seg-${item.id}`}>
            <a
              href={`/para/${item.id}`}
              class="press inline-flex min-h-11 items-center gap-2 rounded-full border border-line-strong bg-surface px-5 font-semibold hover:border-(--seg)"
            >
              <span class="text-(--seg-strong)">
                <SegmentGlyph segment={item.id} size={18} />
              </span>
              {item.data.name}
            </a>
          </li>
        ))}
        <li>
          <a
            href={products.pos.path}
            class="press inline-flex min-h-11 items-center rounded-full border border-line-strong bg-surface px-5 font-semibold hover:border-ink"
          >
            Todo sobre XASKA POS
          </a>
        </li>
      </ul>
    </Section>
  </div>
</BaseLayout>
