+---
+/**
+ * Una pantalla de XASKA POS dibujada en código, con datos de ejemplo de un minimercado de
+ * prueba (y un restaurante en "mesas"). Reemplaza las capturas: se ve nítida en cualquier
+ * pantalla y no muestra datos de clientes reales.
+ *
+ * La pantalla entera es una imagen para los lectores de pantalla (role="img") con la
+ * descripción del contenido; lo de adentro es decorativo.
+ * Los datos son ilustrativos: no son cifras de ningún negocio.
+ */
+import { formatPesos } from '@/lib/money';
+
+type Screen = 'inicio' | 'tiquete' | 'cierre' | 'fiado' | 'sin-conexion' | 'finanzas' | 'mesas';
+
+interface Props {
+  screen: Screen;
+  title: string;
+  description: string;
+  class?: string | undefined;
+}
+
+const { screen, title, description, class: className } = Astro.props;
+
+const hours = [
+  { h: '8', v: 30 },
+  { h: '9', v: 46 },
+  { h: '10', v: 58 },
+  { h: '11', v: 72 },
+  { h: '12', v: 95 },
+  { h: '1', v: 64 },
+  { h: '2', v: 50 },
+  { h: '3', v: 61 },
+  { h: '4', v: 78 },
+  { h: '5', v: 88 },
+];
+
+const ticketLines = [
+  { qty: 2, name: 'Arroz 1 kg', value: 8400 },
+  { qty: 1, name: 'Leche 1 L', value: 4600 },
+  { qty: 1, name: 'Huevos x 12', value: 13800 },
+];
+const ticketTotal = ticketLines.reduce((acc, line) => acc + line.value, 0);
+
+const tables = [
+  { name: 'Mesa 1', state: 'libre', label: 'Libre', amount: null },
+  { name: 'Mesa 2', state: 'cocina', label: 'En cocina', amount: 48500 },
+  { name: 'Mesa 3', state: 'comiendo', label: 'Comiendo', amount: 72000 },
+  { name: 'Mesa 4', state: 'cuenta', label: 'Pidió la cuenta', amount: 35900 },
+  { name: 'Mesa 5', state: 'libre', label: 'Libre', amount: null },
+  { name: 'Mesa 6', state: 'comiendo', label: 'Comiendo', amount: 118400 },
+] as const;
+---
+
+<div class:list={['pos-frame', className]}>
+  <div class="pos-screen ps flex h-full flex-col gap-3 p-4" role="img" aria-label={description}>
+    <div class="flex items-center justify-between gap-2">
+      <span class="text-[0.9rem] font-bold">{title}</span>
+      {screen === 'sin-conexion' ? (
+        <span class="ps-pill ps-warn">Sin conexión</span>
+      ) : screen === 'mesas' ? (
+        <span class="ps-pill ps-soft">Primer piso</span>
+      ) : (
+        <span class="ps-pill ps-ok">Caja abierta</span>
+      )}
+    </div>
+
+    {screen === 'inicio' && (
+      <>
+        <div class="grid grid-cols-2 gap-2">
+          <div class="ps-tile ps-feature">
+            <span class="text-xs">Ventas de hoy</span>
+            <span class="text-lg font-extrabold">{formatPesos(1286400)}</span>
+          </div>
+          <div class="ps-tile">
+            <span class="ps-muted text-xs">Utilidad</span>
+            <span class="text-lg font-extrabold">{formatPesos(318900)}</span>
+          </div>
+          <div class="ps-tile">
+            <span class="ps-muted text-xs">Ventas</span>
+            <span class="text-lg font-extrabold">64</span>
+          </div>
+          <div class="ps-tile">
+            <span class="ps-muted text-xs">Ticket promedio</span>
+            <span class="text-lg font-extrabold">{formatPesos(20100)}</span>
+          </div>
+        </div>
+        <div class="ps-tile">
+          <span class="ps-muted text-xs">Ventas por hora</span>
+          <div class="mt-2 flex h-20 items-end gap-1.5">
+            {hours.map((bar) => (
+              <span class="flex flex-1 flex-col items-center justify-end gap-1">
+                <span class="ps-bar w-full" data-h={bar.v} />
+                <span class="ps-muted text-[0.625rem]">{bar.h}</span>
+              </span>
+            ))}
+          </div>
+        </div>
+        <div class="ps-tile gap-1.5 text-sm">
+          <span class="ps-muted text-xs">Lo más vendido</span>
+          <span class="flex justify-between">
+            <span>Huevos x 12</span>
+            <strong>38</strong>
+          </span>
+          <span class="flex justify-between">
+            <span>Arroz 1 kg</span>
+            <strong>31</strong>
+          </span>
+        </div>
+      </>
+    )}
+
+    {screen === 'tiquete' && (
+      <div class="flex flex-1 flex-col items-center gap-3">
+        <div class="ps-ticket w-full max-w-[15rem]">
+          <p class="text-center font-bold">Minimercado La Esquina</p>
+          <p class="text-center">Venta 0001-000482 · Caja 1</p>
+          <p class="ps-rule" />
+          {ticketLines.map((line) => (
+            <p class="flex justify-between gap-2">
+              <span>
+                {line.qty} × {line.name}
+              </span>
+              <span>{formatPesos(line.value)}</span>
+            </p>
+          ))}
+          <p class="ps-rule" />
+          <p class="flex justify-between text-[0.95rem] font-bold">
+            <span>TOTAL</span>
+            <span>{formatPesos(ticketTotal)}</span>
+          </p>
+          <p class="flex justify-between">
+            <span>Efectivo</span>
+            <span>{formatPesos(30000)}</span>
+          </p>
+          <p class="flex justify-between">
+            <span>Cambio</span>
+            <span>{formatPesos(30000 - ticketTotal)}</span>
+          </p>
+          <p class="ps-rule" />
+          <p class="text-center">Comprobante interno de venta</p>
+        </div>
+        <div class="flex w-full max-w-[15rem] gap-2">
+          <span class="ps-btn ps-btn-light flex-1">Reimprimir</span>
+          <span class="ps-btn ps-btn-brand flex-1">Enviar ▾</span>
+        </div>
+        <div class="ps-menu w-full max-w-[15rem] text-sm">
+          <span>WhatsApp (texto)</span>
+          <span class="font-semibold">Imagen del tiquete</span>
+        </div>
+      </div>
+    )}
+
+    {screen === 'cierre' && (
+      <div class="flex flex-col gap-2 text-sm">
+        <div class="ps-tile gap-1.5">
+          <span class="ps-muted text-xs">Ventas por medio de pago</span>
+          <span class="flex justify-between">
+            <span>Efectivo</span>
+            <strong>{formatPesos(684000)}</strong>
+          </span>
+          <span class="flex justify-between">
+            <span>Transferencia</span>
+            <strong>{formatPesos(412300)}</strong>
+          </span>
+          <span class="flex justify-between">
+            <span>Tarjeta</span>
+            <strong>{formatPesos(190100)}</strong>
+          </span>
+        </div>
+        <div class="ps-tile gap-1.5">
+          <span class="flex justify-between">
+            <span>Base de apertura</span>
+            <strong>{formatPesos(100000)}</strong>
+          </span>
+          <span class="flex justify-between">
+            <span>Egresos</span>
+            <strong>{formatPesos(-45000)}</strong>
+          </span>
+          <span class="flex justify-between">
+            <span>Efectivo esperado</span>
+            <strong>{formatPesos(739000)}</strong>
+          </span>
+          <span class="flex justify-between">
+            <span>Efectivo contado</span>
+            <strong>{formatPesos(739000)}</strong>
+          </span>
+        </div>
+        <div class="ps-tile ps-good flex-row items-center justify-between">
+          <span class="font-semibold">Diferencia</span>
+          <span class="text-lg font-extrabold">{formatPesos(0)}</span>
+        </div>
+        <div class="flex gap-2">
+          <span class="ps-btn ps-btn-light flex-1">Imprimir</span>
+          <span class="ps-btn ps-btn-brand flex-1">Enviar por WhatsApp</span>
+        </div>
+      </div>
+    )}
+
+    {screen === 'fiado' && (
+      <div class="flex flex-col gap-2 text-sm">
+        <div class="ps-tile gap-2">
+          <span class="flex items-center gap-2">
+            <span class="ps-avatar">DR</span>
+            <span class="font-bold">Doña Rosa</span>
+          </span>
+          <span class="flex justify-between">
+            <span class="ps-muted">Debe</span>
+            <strong class="text-lg">{formatPesos(42300)}</strong>
+          </span>
+          <span class="ps-track">
+            <span class="ps-fill" data-w="28" />
+          </span>
+          <span class="ps-muted flex justify-between text-xs">
+            <span>Cupo {formatPesos(150000)}</span>
+            <span>Disponible {formatPesos(107700)}</span>
+          </span>
+        </div>
+        <div class="ps-tile gap-1.5">
+          <span class="ps-muted text-xs">Movimientos</span>
+          <span class="flex justify-between">
+            <span>Abono · ayer</span>
+            <strong class="ps-ok-text">{formatPesos(-20000)}</strong>
+          </span>
+          <span class="flex justify-between">
+            <span>Venta 0001-000471</span>
+            <strong>{formatPesos(27600)}</strong>
+          </span>
+          <span class="flex justify-between">
+            <span>Venta 0001-000455</span>
+            <strong>{formatPesos(34700)}</strong>
+          </span>
+        </div>
+        <div class="flex gap-2">
